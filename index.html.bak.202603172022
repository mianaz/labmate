  site_directed_mutagenesis: {
    usage: { en: 'Introduce point mutations, insertions, or deletions into plasmid DNA. Based on inverse PCR with KLD (Kinase-Ligase-DpnI) treatment.', zh: '在质粒 DNA 中引入点突变、插入或缺失。基于反向 PCR + KLD（激酶-连接酶-DpnI）处理。' },
    storage: { temp: 'N/A', duration: '', icon: '📋', label: { en: 'Protocol — ~4h (PCR + KLD + transform)', zh: '实验方案 — 约 4h（PCR + KLD + 转化）' } },
    materials: [
      { name: 'Q5 Hot Start 2× Master Mix', note: { en: 'Or similar HF polymerase', zh: '或类似高保真聚合酶' } },
      { name: 'Mutagenic primers (10 µM)', note: { en: 'Design with NEBaseChanger', zh: '用 NEBaseChanger 设计' } },
      { name: 'Template plasmid (1-25 ng/µL)', note: { en: '', zh: '' } },
      { name: 'KLD Enzyme Mix (10×)', note: { en: 'Kinase + Ligase + DpnI', zh: '激酶 + 连接酶 + DpnI' } },
      { name: 'KLD Reaction Buffer (2×)', note: { en: '', zh: '' } },
      { name: 'Competent cells', linkedRecipe: 'competent_cells_cacl2' },
      { name: 'SOC Medium', linkedRecipe: 'soc' },
      { name: 'LB Agar + Antibiotic', linkedRecipe: 'lb_agar' },
    ],
    briefSteps: [
      { en: 'Design back-to-back mutagenic primers → Q5 inverse PCR → KLD reaction (5 min RT) → transform → sequence-verify', zh: '设计背靠背突变引物 → Q5 反向 PCR → KLD 反应（RT 5 min）→ 转化 → 测序验证' },
    ],
    detailedSteps: [
      { en: 'Design mutagenic primers using NEBaseChanger (nebasechanger.neb.com). Primers should be back-to-back on the template', zh: '使用 NEBaseChanger (nebasechanger.neb.com) 设计突变引物。引物应在模板上背靠背排列' },
      { en: 'Set up PCR: 12.5 µL Q5 2× Master Mix + 1.25 µL forward primer (10 µM) + 1.25 µL reverse primer (10 µM) + 1 µL template (1-25 ng) + 9 µL ddH₂O', zh: '配制 PCR 体系：12.5 µL Q5 2× Master Mix + 1.25 µL 正向引物 (10 µM) + 1.25 µL 反向引物 (10 µM) + 1 µL 模板 (1-25 ng) + 9 µL ddH₂O' },
      { en: 'PCR cycling: 98°C 30s initial denaturation → 25 cycles of (98°C 10s → Tm°C 10-30s → 72°C 20-30s/kb) → 72°C 2 min final extension → hold 4°C', zh: 'PCR 程序：98°C 30s 初始变性 → 25 个循环（98°C 10s → Tm°C 10-30s → 72°C 20-30s/kb）→ 72°C 2 min 终延伸 → 4°C 保持' },
      { en: 'Check PCR product on 1% agarose gel. Should see a single band at expected size', zh: '1% 琼脂糖凝胶检测 PCR 产物。应看到预期大小的单一条带' },
      { en: 'Set up KLD reaction: 1 µL PCR product + 5 µL KLD Buffer (2×) + 1 µL KLD Enzyme Mix (10×) + 3 µL ddH₂O', zh: '配制 KLD 反应：1 µL PCR 产物 + 5 µL KLD Buffer (2×) + 1 µL KLD Enzyme Mix (10×) + 3 µL ddH₂O' },
      { en: 'Mix by pipetting. Incubate at room temperature for 5 min', zh: '吹打混匀。室温孵育 5 min' },
      { en: 'Transform 5 µL KLD mix into 50 µL competent cells. Ice 30 min → heat shock 42°C 30s → ice 5 min', zh: '取 5 µL KLD 混合物转化 50 µL 感受态细胞。冰浴 30 min → 42°C 热激 30s → 冰浴 5 min' },
      { en: 'Add 950 µL SOC. Shake at 37°C for 1h', zh: '加 950 µL SOC。37°C 振荡 1h' },
      { en: 'Plate 50-100 µL on selective plates. Incubate overnight at 37°C', zh: '取 50-100 µL 涂板。37°C 过夜培养' },
      { en: 'Pick 2-4 colonies for sequencing. Typical mutagenesis efficiency: >80%', zh: '挑 2-4 个克隆送测序。典型突变效率：>80%' },
    ],
  },
  transwell_migration: {
    usage: { en: 'Quantitative assay for cell migration/invasion using Boyden chamber principle. Count migrated cells after crystal violet staining.', zh: '基于 Boyden 小室原理的定量细胞迁移/侵袭实验。结晶紫染色后计数迁移细胞。' },
    storage: { temp: 'N/A', duration: '', icon: '📋', label: { en: 'Protocol — 2 days (starve + migrate)', zh: '实验方案 — 2 天（饥饿 + 迁移）' } },
    materials: [
      { name: 'Transwell inserts (8 µm pore)', note: { en: 'Corning #3422 or similar', zh: 'Corning #3422 或类似' } },
      { name: '24-well plate', note: { en: 'Companion plate', zh: '配套培养板' } },
      { name: 'Serum-free medium', note: { en: 'Upper chamber', zh: '上室用' } },
      { name: 'Complete medium (10% FBS)', linkedRecipe: 'complete_dmem', note: { en: 'Lower chamber chemoattractant', zh: '下室趋化因子' } },
      { name: 'PBS (1×)', linkedRecipe: 'pbs_1x' },
      { name: 'Crystal Violet (0.5%)', linkedRecipe: 'crystal_violet_stain' },
      { name: 'Methanol or 4% PFA', note: { en: 'For fixation', zh: '用于固定' } },
      { name: 'Cotton swabs', note: { en: 'To remove non-migrated cells', zh: '去除未迁移细胞' } },
    ],
    briefSteps: [
      { en: 'Serum-starve → seed cells in upper chamber (serum-free) → chemoattractant in lower → incubate 16-24h → swab upper surface → fix → crystal violet stain → count', zh: '血清饥饿 → 上室接种细胞（无血清）→ 下室加趋化因子 → 孵育 16-24h → 棉签擦上表面 → 固定 → 结晶紫染色 → 计数' },
    ],
    detailedSteps: [
      { en: 'Serum-starve cells for 12-24h before assay to synchronize migration response', zh: '实验前血清饥饿 12-24h 以同步迁移响应' },
      { en: 'Optional (invasion assay): Coat upper surface of Transwell insert with 50 µL Matrigel (1:8 dilution in serum-free medium). Incubate 1-2h at 37°C to solidify', zh: '可选（侵袭实验）：在 Transwell 上表面涂 50 µL Matrigel（无血清培养基 1:8 稀释）。37°C 孵育 1-2h 凝固' },
      { en: 'Add 600 µL complete medium (10% FBS) to lower chamber of 24-well plate as chemoattractant. For negative control, use serum-free medium in lower chamber', zh: '在 24 孔板下室加 600 µL 完全培养基（10% FBS）作为趋化因子。阴性对照：下室加无血清培养基' },
      { en: 'Trypsinize starved cells, count, and resuspend in serum-free medium at 2-5×10⁵ cells/mL', zh: '消化饥饿细胞，计数，用无血清培养基重悬至 2-5×10⁵ cells/mL' },
      { en: 'Add 200 µL cell suspension to upper chamber of Transwell insert (4-10×10⁴ cells)', zh: '取 200 µL 细胞悬液加入 Transwell 上室（4-10×10⁴ 个细胞）' },
      { en: 'Carefully place insert into well. Avoid air bubbles between insert and lower medium', zh: '小心将小室放入孔中。避免小室与下室液面间产生气泡' },
      { en: 'Incubate at 37°C, 5% CO₂ for 16-24h (varies by cell type; fast migrators like MDA-MB-231 may need only 8h)', zh: '37°C, 5% CO₂ 孵育 16-24h（因细胞类型而异；快速迁移细胞如 MDA-MB-231 可能只需 8h）' },
      { en: 'Remove insert. Gently wipe upper surface with moist cotton swab to remove non-migrated cells. Repeat 2-3×', zh: '取出小室。用湿棉签轻轻擦拭上表面去除未迁移细胞。重复 2-3 次' },
      { en: 'Fix cells on lower surface: dip in methanol for 10 min or 4% PFA for 15 min', zh: '固定下表面细胞：浸入甲醇 10 min 或 4% PFA 15 min' },
      { en: 'Stain with 0.5% crystal violet for 20 min. Rinse excess stain in water', zh: '0.5% 结晶紫染色 20 min。水洗去多余染液' },
      { en: 'Air-dry inserts. Image 5 random fields per insert under microscope (20× objective)', zh: '晾干小室。显微镜下（20× 物镜）每个小室随机拍摄 5 个视野' },
      { en: '**Analysis**: Count stained cells per field using ImageJ. Report as average cells/field ± SEM. Compare conditions by t-test or ANOVA', zh: '**分析**：用 ImageJ 计数每视野染色细胞。报告平均 cells/field ± SEM。用 t 检验或 ANOVA 比较各组' },
    ],
  },
  mycoplasma_pcr: {
    usage: { en: 'Fast, sensitive PCR-based detection of mycoplasma contamination in cell cultures. Test every cell line every 2-4 weeks.', zh: '快速灵敏的 PCR 法检测细胞培养支原体污染。每 2-4 周检测一次。' },
    storage: { temp: 'N/A', duration: '', icon: '📋', label: { en: 'Protocol — ~3h (prep + PCR + gel)', zh: '实验方案 — 约 3h（准备 + PCR + 跑胶）' } },
    materials: [
      { name: 'Cell culture supernatant', note: { en: '48-72h conditioned', zh: '48-72h 条件培养基' } },
      { name: 'Taq 2× Master Mix', note: { en: 'Standard Taq, not HF', zh: '普通 Taq，非高保真' } },
      { name: 'Forward primer (10 µM)', note: { en: "GPO-3: 5'-GGGAGCAAACAGGATTAGATACCCT-3'", zh: 'GPO-3 引物' } },
      { name: 'Reverse primer (10 µM)', note: { en: "MGSO: 5'-TGCACCATCTGTCACTCTGTTAACCTC-3'", zh: 'MGSO 引物' } },
      { name: 'Agarose gel (2%)', note: { en: 'For detection of ~270 bp band', zh: '检测约 270 bp 条带' } },
      { name: 'DNA ladder (100 bp)', note: { en: '', zh: '' } },
    ],
    briefSteps: [
      { en: 'Collect conditioned medium → pellet mycoplasma → boil to lyse → PCR (GPO-3/MGSO) → 2% agarose gel → ~270 bp band = positive', zh: '收集条件培养基 → 离心沉淀支原体 → 煮沸裂解 → PCR (GPO-3/MGSO) → 2% 琼脂糖凝胶 → ~270 bp 条带 = 阳性' },
    ],
    detailedSteps: [
      { en: 'Collect 1 mL conditioned medium from cells cultured 48-72h without medium change. Use supernatant (mycoplasma is extracellular)', zh: '收集 1 mL 未换液培养 48-72h 的条件培养基。使用上清（支原体为胞外寄生）' },
      { en: 'Centrifuge at 250 × g for 5 min to pellet cells. Transfer supernatant', zh: '250 × g 离心 5 min 沉淀细胞。转移上清' },
      { en: 'Centrifuge supernatant at 15,000 × g for 10 min. Discard supernatant. Resuspend pellet in 50 µL ddH₂O', zh: '上清 15,000 × g 离心 10 min。弃上清。用 50 µL ddH₂O 重悬沉淀' },
      { en: 'Boil at 95°C for 10 min to lyse mycoplasma and release DNA. Quick-spin', zh: '95°C 煮沸 10 min 裂解支原体释放 DNA。快速离心' },
      { en: 'Set up PCR: 12.5 µL Taq 2× Master Mix + 1 µL GPO-3 primer (10 µM) + 1 µL MGSO primer (10 µM) + 2 µL template (boiled supernatant) + 8.5 µL ddH₂O', zh: '配制 PCR：12.5 µL Taq 2× Master Mix + 1 µL GPO-3 引物 (10 µM) + 1 µL MGSO 引物 (10 µM) + 2 µL 模板（煮沸上清）+ 8.5 µL ddH₂O' },
      { en: 'Include positive control (known contaminated DNA or synthetic template) and negative control (ddH₂O)', zh: '设阳性对照（已知污染 DNA 或合成模板）和阴性对照（ddH₂O）' },
      { en: 'PCR cycling: 94°C 5 min → 35 cycles of (94°C 30s → 55°C 30s → 72°C 30s) → 72°C 5 min', zh: 'PCR 程序：94°C 5 min → 35 个循环（94°C 30s → 55°C 30s → 72°C 30s）→ 72°C 5 min' },
      { en: 'Run products on 2% agarose gel with 100 bp ladder. Look for band at ~270 bp', zh: '2% 琼脂糖凝胶电泳，加 100 bp ladder。观察 ~270 bp 处条带' },
      { en: '**Interpretation**: Band at ~270 bp = POSITIVE (contaminated). No band = NEGATIVE. Positive control must show band for valid test. If contaminated: discard cells, bleach hood, check medium and reagents', zh: '**判读**：~270 bp 条带 = 阳性（污染）。无条带 = 阴性。阳性对照必须出带才有效。若污染：丢弃细胞，漂白超净台，检查培养基和试剂' },
    ],
  },
};

// Apply all enhancements to RECIPES
RECIPES.forEach(r => {
  const bufEnh = BUFFER_ENHANCEMENTS[r.id];
  const protoEnh = PROTOCOL_ENHANCEMENTS[r.id];
  const enh = bufEnh || protoEnh;
  if (enh) {
    if (enh.usage) r.usage = enh.usage;
    if (enh.storage) r.storage = enh.storage;
    if (enh.relatedProtocols) r.relatedProtocols = enh.relatedProtocols;
    if (enh.steps) r.prepSteps = enh.steps;
    if (enh.briefSteps) r.briefSteps = enh.briefSteps;
    if (enh.detailedSteps) r.detailedSteps = enh.detailedSteps;
    if (enh.materials) r.materials = enh.materials;
  }
});

// Safe stop points for protocols
const SAFE_STOPS = {
  wb_protocol: [
    { afterStep: 2, note: { en: 'Lysate can be stored at -80\u00B0C for months', zh: '裂解液可 -80\u00B0C 保存数月' } },
    { afterStep: 11, note: { en: 'Membrane can be stored dry at -20\u00B0C or in TBST at 4\u00B0C overnight', zh: '膜可 -20\u00B0C 干燥保存或 4\u00B0C TBST 中过夜' } },
    { afterStep: 13, note: { en: 'Can incubate overnight at 4\u00B0C (recommended for many antibodies)', zh: '可 4\u00B0C 过夜孵育（推荐用于多数抗体）' } },
  ],
  chip_protocol: [
    { afterStep: 4, note: { en: 'Lysate can be stored at -80\u00B0C', zh: '裂解液可 -80\u00B0C 保存' } },
    { afterStep: 7, note: { en: 'Sheared chromatin can be stored at -80\u00B0C for weeks', zh: '剪切后染色质可 -80\u00B0C 保存数周' } },
  ],
  coip_protocol: [
    { afterStep: 1, note: { en: 'Lysate can be stored at -80\u00B0C', zh: '裂解液可 -80\u00B0C 保存' } },
  ],
  trizol_extraction: [
    { afterStep: 5, note: { en: 'Aqueous phase can be stored at -80\u00B0C', zh: '水相可 -80\u00B0C 保存' } },
    { afterStep: 9, note: { en: 'RNA pellet in 75% ethanol can be stored at -80\u00B0C for months', zh: 'RNA 沉淀在 75% 乙醇中可 -80\u00B0C 保存数月' } },
  ],
  qpcr_protocol: [
    { afterStep: 3, note: { en: 'cDNA can be stored at -20\u00B0C for months', zh: 'cDNA 可 -20\u00B0C 保存数月' } },
  ],
  flow_cytometry_protocol: [
    { afterStep: 8, note: { en: 'Fixed cells can be stored at 4\u00B0C for up to a week', zh: '固定后的细胞可 4\u00B0C 保存最多一周' } },
  ],
  // ── v2.1 new safe stops ──
  miniprep_protocol: [
    { afterStep: 0, note: { en: 'Bacterial pellet can be stored at -20\u00B0C', zh: '菌体沉淀可 -20\u00B0C 保存' } },
    { afterStep: 10, note: { en: 'DNA pellet in 70% ethanol can be stored at -20\u00B0C for months', zh: 'DNA 沉淀在 70% 乙醇中可 -20\u00B0C 保存数月' } },
  ],
  cell_freezing: [
    { afterStep: 9, note: { en: 'Cells can remain at -80\u00B0C for up to 3 months, but transfer to liquid nitrogen for long-term viability', zh: '细胞可在 -80\u00B0C 保存最多 3 个月，但建议转入液氮以保持长期活力' } },
  ],
  electroporation: [
    { afterStep: 0, note: { en: 'Electrocompetent cells can be refrozen if not contaminated with DNA, but efficiency decreases', zh: '未接触 DNA 的电转感受态细胞可重新冻存，但效率会降低' } },
  ],
  // ── batch 2 safe stops ──
  lentivirus_production: [
    { afterStep: 10, note: { en: 'Filtered virus can be aliquoted and snap-frozen in liquid nitrogen. Store at -80°C (titer drops ~50% per freeze-thaw cycle)', zh: '过滤后的病毒可分装并液氮速冻。-80°C 保存（每次冻融滴度下降约 50%）' } },
  ],
};
RECIPES.forEach(r => { if (SAFE_STOPS[r.id]) r.safeStops = SAFE_STOPS[r.id]; });

// Build recipe lookup for cross-linking
const RECIPE_BY_ID = {};
RECIPES.forEach(r => { RECIPE_BY_ID[r.id] = r; });

