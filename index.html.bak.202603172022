  sds_page_gel: {
    usage: { en: 'Standard SDS-PAGE gel for protein separation. 10% resolving gel separates 20–80 kDa. Adjust % for your target MW — use the Gel Calculator for custom volumes.', zh: '标准 SDS-PAGE 蛋白分离凝胶。10% 分离胶分辨 20–80 kDa。可根据目标分子量调整浓度——使用配胶计算器自定义体积。' },
    storage: { temp: 'RT', duration: 'Pour fresh', icon: '⏱️', label: { en: 'Pour immediately — polymerizes in ~30 min', zh: '立即灌胶——约 30 分钟凝固' } },
    relatedProtocols: ['wb_protocol'],
    steps: [
