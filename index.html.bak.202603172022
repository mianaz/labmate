    ),
    React.createElement(InvInput, { label: t('invColor', lang), value: form.color, onChange: v => set('color', v), type: 'color' }),
    React.createElement('div', { className: 'flex gap-2 mt-4 justify-end' },
      React.createElement('button', { style: invBtnSecStyle, onClick: onClose }, t('invCancel', lang)),
      React.createElement('button', { style: { ...invBtnStyle, opacity: form.name ? 1 : 0.5 }, disabled: !form.name, onClick: () => { if (form.name) onSave(form); } }, t('invSave', lang))
