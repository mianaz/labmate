      options: Object.entries(STORAGE_TYPE_LABELS).map(([val, lbl]) => ({ value: val, label: t(lbl, lang) }))
    }),
    React.createElement(InvSelect, { label: t('invTemperature', lang), value: form.temperature, onChange: v => set('temperature', v),
      options: [
        { value: '', label: '—' },
        { value: 'RT', label: 'RT (Room Temp)' },
        { value: '4°C', label: '4°C' },
        { value: '-20°C', label: '-20°C' },
        { value: '-80°C', label: '-80°C' },
        { value: '-196°C (LN₂)', label: '-196°C (LN₂)' },
        { value: '37°C', label: '37°C' },
        { value: '4°F (freezer)', label: '4°F (freezer)' },
        { value: '-4°F', label: '-4°F' },
        { value: '-112°F', label: '-112°F' },
      ]
    }),
    React.createElement('div', { className: 'flex gap-2 mt-4 justify-end' },
      React.createElement('button', { style: invBtnSecStyle, onClick: onClose }, t('invCancel', lang)),
      React.createElement('button', { style: { ...invBtnStyle, opacity: form.name ? 1 : 0.5 }, disabled: !form.name, onClick: () => { if (form.name) onSave(form); } }, t('invSave', lang))
    )
  );
}

