  dilPrepToGet: { en: 'to get', zh: '以获得' },
  dilPrepFrom: { en: 'from', zh: '取自' },
  // Mass calc descriptive labels
  massMwDesc: { en: 'Molecular Weight of reagent', zh: '试剂分子量' },
  massConcDesc: { en: 'Desired molar concentration', zh: '目标摩尔浓度' },
