      React.createElement('div', {
        className: 'relative w-full max-w-md rounded-xl p-6',
        style: { background: 'var(--card)', border: '1px solid var(--border)', boxShadow: '0 20px 40px rgba(0,0,0,0.15)', maxHeight: '85vh', overflowY: 'auto' },
        onClick: e => e.stopPropagation(),
