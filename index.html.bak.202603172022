function posLabel(row, col) {
  return String.fromCharCode(65 + row) + (col + 1);
}

function BoxGrid({ box, samples, onCellClick, lang, selectMode, selectedCells, onToggleSelect, onDragSelect }) {
  if (!box) return null;
  const sampleMap = {};
  samples.forEach(s => { if (s.position) sampleMap[s.position] = s; });
  const occupied = Object.keys(sampleMap).length;
  const total = box.rows * box.cols;
  const cellSize = Math.max(24, Math.min(40, Math.floor(300 / Math.max(box.rows, box.cols))));
  const dragStart = useRef(null);
  const [dragging, setDragging] = useState(false);

  const handleMouseDown = (r, c) => {
    if (!selectMode) return;
    dragStart.current = { r, c };
    setDragging(true);
  };
  const handleMouseUp = (r, c) => {
    if (!selectMode || !dragStart.current) return;
    if (dragStart.current.r === r && dragStart.current.c === c) {
      onToggleSelect && onToggleSelect(posLabel(r, c));
    } else {
      const r0 = Math.min(dragStart.current.r, r), r1 = Math.max(dragStart.current.r, r);
      const c0 = Math.min(dragStart.current.c, c), c1 = Math.max(dragStart.current.c, c);
      const positions = [];
      for (let ri = r0; ri <= r1; ri++) for (let ci = c0; ci <= c1; ci++) positions.push(posLabel(ri, ci));
      onDragSelect && onDragSelect(positions);
    }
    dragStart.current = null;
    setDragging(false);
  };
  const handleMouseEnter = (e, r, c) => {
    if (!selectMode || !dragging) { if (!selectMode) e.currentTarget.style.transform = 'scale(1.15)'; return; }
  };

  return React.createElement('div', null,
    React.createElement('div', { className: 'flex items-center justify-between mb-3' },
      React.createElement('div', { className: 'flex items-center gap-2' },
        React.createElement('span', { className: 'text-sm font-semibold', style: { color: 'var(--text)' } },
          lang === 'zh' ? (box.nameZh || box.name) : box.name),
        box.color && React.createElement('span', { style: { display: 'inline-block', width: 12, height: 12, borderRadius: 3, background: box.color } })
      ),
      React.createElement('span', { className: 'text-xs', style: { color: 'var(--text-muted)' } },
        occupied + '/' + total + ' ' + t('invOccupied', lang) + ' \u00B7 ' + (total - occupied) + ' ' + t('invEmpty', lang))
    ),
    React.createElement('div', { style: { overflowX: 'auto', userSelect: selectMode ? 'none' : 'auto' } },
      React.createElement('div', {
        style: { display: 'inline-grid', gridTemplateColumns: 'auto ' + 'repeat(' + box.cols + ', ' + cellSize + 'px)', gap: '2px', fontSize: '10px' },
      },
        React.createElement('div'),
        ...Array.from({ length: box.cols }, (_, c) =>
          React.createElement('div', { key: 'h' + c, className: 'text-center', style: { color: 'var(--text-muted)', lineHeight: cellSize + 'px' } }, c + 1)
        ),
        ...Array.from({ length: box.rows }, (_, r) => [
          React.createElement('div', { key: 'r' + r, className: 'flex items-center justify-center', style: { color: 'var(--text-muted)', width: 20 } }, String.fromCharCode(65 + r)),
          ...Array.from({ length: box.cols }, (_, c) => {
            const pos = posLabel(r, c);
            const sample = sampleMap[pos];
            const colors = sample ? (SAMPLE_TYPE_COLORS[sample.sampleType] || SAMPLE_TYPE_COLORS.other) : null;
            const isSelected = selectMode && selectedCells && selectedCells.has(pos);
            return React.createElement('div', {
              key: pos,
              onClick: () => { if (!selectMode) onCellClick(pos, sample); },
              onMouseDown: () => handleMouseDown(r, c),
              onMouseUp: () => handleMouseUp(r, c),
              onMouseEnter: e => handleMouseEnter(e, r, c),
              title: sample ? (sample.name + ' (' + pos + ')') : pos,
              style: {
                width: cellSize, height: cellSize, borderRadius: 4, cursor: selectMode ? 'crosshair' : 'pointer',
                background: isSelected ? 'var(--primary)' : sample ? colors.bg : 'var(--bg-2)',
                border: isSelected ? '2px solid var(--primary)' : sample ? '2px solid ' + colors.text + '33' : '1px solid var(--border)',
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                color: isSelected ? '#fff' : sample ? colors.text : 'var(--text-muted)',
                fontWeight: sample ? 600 : 400, fontSize: cellSize > 30 ? '9px' : '7px',
                transition: 'transform 0.1s, background 0.1s',
                position: 'relative',
              },
              onMouseLeave: e => { if (!selectMode) e.currentTarget.style.transform = 'scale(1)'; },
            }, isSelected ? '✓' : sample ? sample.name.slice(0, 3) : '');
          })
        ]).flat()
      )
    ),
    React.createElement('div', { className: 'flex flex-wrap gap-2 mt-3' },
      ...Object.entries(SAMPLE_TYPE_COLORS).filter(([type]) => samples.some(s => s.sampleType === type)).map(([type, colors]) =>
        React.createElement('span', { key: type, className: 'text-xs px-2 py-0.5 rounded-full', style: { background: colors.bg, color: colors.text, fontWeight: 500 } }, t(SAMPLE_TYPE_LABELS[type], lang))
      )
    ),
    !selectMode && React.createElement('p', { className: 'text-xs mt-2', style: { color: 'var(--text-muted)' } }, t('invClickToAdd', lang))
  );
}

function StorageTree({ data, selectedBoxId, onSelectBox, onAddLocation, onEditLocation, onDeleteLocation, onAddBox, onEditBox, onDeleteBox, lang }) {
  const [expanded, setExpanded] = useState({});
  const toggle = (id) => setExpanded(prev => ({ ...prev, [id]: !prev[id] }));
  const [hovered, setHovered] = useState(null);
  const [confirmDel, setConfirmDel] = useState(null);

  return React.createElement('div', null,
    React.createElement('div', { className: 'flex items-center justify-between mb-2' },
      React.createElement('span', { className: 'text-sm font-semibold', style: { color: 'var(--text)', fontFamily: 'var(--font-heading)' } }, t('invStorageTree', lang)),
      React.createElement('button', { onClick: onAddLocation, style: { ...invBtnStyle, padding: '4px 10px', fontSize: '12px' } }, '+ ' + t('invAddLocation', lang))
    ),
    data.locations.length === 0 && React.createElement('p', { className: 'text-xs py-4 text-center', style: { color: 'var(--text-muted)' } },
      t('invAddLocation', lang)
    ),
    data.locations.map(loc => {
      const boxes = data.boxes.filter(b => b.locationId === loc.id);
      const isExp = expanded[loc.id] !== false;
      return React.createElement('div', { key: loc.id, className: 'mb-1' },
        React.createElement('div', {
          className: 'flex items-center gap-1 px-2 py-1.5 rounded-lg cursor-pointer text-sm',
          style: { background: hovered === 'loc-' + loc.id ? 'var(--bg-2)' : 'transparent', transition: 'background 0.15s' },
          onClick: () => toggle(loc.id),
          onMouseEnter: () => setHovered('loc-' + loc.id),
          onMouseLeave: () => setHovered(null),
        },
          React.createElement('span', { className: 'text-xs', style: { color: 'var(--text-muted)', transform: isExp ? 'rotate(90deg)' : 'none', transition: 'transform 0.15s', display: 'inline-block' } }, '\u25B6'),
          React.createElement(StorageIcon, { type: loc.type, size: 14 }),
          React.createElement('span', { className: 'flex-1 font-medium', style: { color: 'var(--text)' } }, lang === 'zh' ? (loc.nameZh || loc.name) : loc.name),
          loc.temperature && React.createElement('span', { className: 'text-xs px-1.5 py-0.5 rounded', style: { background: 'var(--bg-2)', color: 'var(--text-muted)', fontFamily: 'var(--font-mono)' } }, loc.temperature),
          hovered === 'loc-' + loc.id && React.createElement(React.Fragment, null,
            React.createElement('button', {
              onClick: e => { e.stopPropagation(); onEditLocation(loc); },
              className: 'text-xs px-1', style: { color: 'var(--primary)', background: 'none', border: 'none', cursor: 'pointer' }, title: t('invEditLocation', lang)
            }, '\u270E'),
            React.createElement('button', {
              onClick: e => { e.stopPropagation(); onAddBox(loc.id); },
              className: 'text-xs px-1', style: { color: 'var(--primary)', background: 'none', border: 'none', cursor: 'pointer' }, title: t('invAddBox', lang)
            }, '+'),
            React.createElement('button', {
              onClick: e => { e.stopPropagation(); if (confirmDel === 'loc-' + loc.id) { onDeleteLocation(loc.id); setConfirmDel(null); } else setConfirmDel('loc-' + loc.id); },
              className: 'text-xs px-1', style: { color: '#dc2626', background: 'none', border: 'none', cursor: 'pointer' },
              title: confirmDel === 'loc-' + loc.id ? t('invConfirm', lang) : t('invDeleteLocation', lang)
            }, confirmDel === 'loc-' + loc.id ? '!!' : '\u2715')
          )
        ),
        isExp && boxes.map(box => {
          const sampleCount = data.samples.filter(s => s.boxId === box.id).length;
          const totalSlots = box.rows * box.cols;
          return React.createElement('div', {
            key: box.id,
            className: 'flex items-center gap-1 pl-7 pr-2 py-1 rounded-lg cursor-pointer text-sm',
            style: { background: selectedBoxId === box.id ? 'var(--primary-light)' : hovered === 'box-' + box.id ? 'var(--bg-2)' : 'transparent', transition: 'background 0.15s' },
            onClick: () => onSelectBox(box.id),
            onMouseEnter: () => setHovered('box-' + box.id),
            onMouseLeave: () => setHovered(null),
          },
            box.color ? React.createElement('span', { style: { display: 'inline-block', width: 8, height: 8, borderRadius: 2, background: box.color, flexShrink: 0 } })
              : React.createElement('svg', { width: 14, height: 14, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 2, style: { color: 'var(--text-muted)' } },
                React.createElement('rect', { x: 3, y: 3, width: 18, height: 18, rx: 2 }),
                React.createElement('line', { x1: 3, y1: 9, x2: 21, y2: 9 }),
                React.createElement('line', { x1: 9, y1: 3, x2: 9, y2: 21 })
              ),
            React.createElement('span', { className: 'flex-1', style: { color: selectedBoxId === box.id ? 'var(--primary)' : 'var(--text)' } }, lang === 'zh' ? (box.nameZh || box.name) : box.name),
            React.createElement('span', { className: 'text-xs', style: { color: 'var(--text-muted)', fontFamily: 'var(--font-mono)' } }, sampleCount + '/' + totalSlots),
            hovered === 'box-' + box.id && React.createElement(React.Fragment, null,
              React.createElement('button', {
                onClick: e => { e.stopPropagation(); onEditBox(box); },
                className: 'text-xs px-1', style: { color: 'var(--primary)', background: 'none', border: 'none', cursor: 'pointer' }
              }, '\u270E'),
              React.createElement('button', {
                onClick: e => { e.stopPropagation(); if (confirmDel === 'box-' + box.id) { onDeleteBox(box.id); setConfirmDel(null); } else setConfirmDel('box-' + box.id); },
                className: 'text-xs px-1', style: { color: '#dc2626', background: 'none', border: 'none', cursor: 'pointer' }
              }, confirmDel === 'box-' + box.id ? '!!' : '\u2715')
            )
          );
        })
