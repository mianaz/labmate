      React.createElement('div', { className: 'flex-1' }, React.createElement(InvInput, { label: t('invConcentration', lang), value: form.concentration, onChange: v => set('concentration', v) }))
    ),
    React.createElement('div', { className: 'flex gap-2' },
      React.createElement('div', { className: 'flex-1' }, React.createElement(InvInput, { label: t('invPassage', lang), value: form.passage, onChange: v => set('passage', v) })),
      React.createElement('div', { className: 'flex-1' }, React.createElement(InvInput, { label: t('invOwner', lang), value: form.owner, onChange: v => set('owner', v) }))
    ),
    React.createElement('div', { className: 'flex gap-2', style: { flexWrap: 'wrap' } },
      React.createElement('div', { style: { flex: '1 1 140px', minWidth: 140 } }, React.createElement(InvInput, { label: t('invDateStored', lang), value: form.dateStored, onChange: v => set('dateStored', v), type: 'date' })),
      React.createElement('div', { style: { flex: '1 1 140px', minWidth: 140 } }, React.createElement(InvInput, { label: t('invExpiryDate', lang), value: form.expiryDate, onChange: v => set('expiryDate', v), type: 'date' }))
    ),
    React.createElement(InvInput, { label: t('invTags', lang), value: form.tags, onChange: v => set('tags', v) }),
    React.createElement(InvTextarea, { label: t('invDescription', lang), value: form.description, onChange: v => set('description', v), rows: 2 }),
    React.createElement(InvTextarea, { label: t('invNotes', lang), value: form.notes, onChange: v => set('notes', v), rows: 2 }),
    React.createElement('div', { className: 'flex gap-2 mt-4 justify-between' },
      initial ? React.createElement('div', { className: 'flex gap-2 items-center' },
        !confirmDelete ? React.createElement('button', { style: { ...invBtnDangerStyle, opacity: 0.8 }, onClick: () => setConfirmDelete(true) }, t('invDeleteSample', lang))
        : React.createElement('div', { className: 'flex gap-2 items-center' },
          React.createElement('span', { className: 'text-xs', style: { color: '#dc2626' } }, t('invDeleteConfirm', lang)),
          React.createElement('button', { style: invBtnDangerStyle, onClick: () => { onDelete(initial.id); onClose(); } }, t('invConfirm', lang))
        ),
