    briefSteps: [
      { en: 'Design overlapping primers → PCR amplify fragments → assemble at 50°C (15-60 min) → transform → plate', zh: '设计重叠引物 → PCR 扩增片段 → 50°C 组装 (15-60 min) → 转化 → 涂板' },
    ],
    detailedSteps: [
      { en: 'Design primers with 15-25 bp overlapping regions between adjacent fragments. Use NEBuilder (nebuilder.neb.com) for primer design', zh: '设计引物，使相邻片段间有 15-25 bp 重叠区。使用 NEBuilder (nebuilder.neb.com) 辅助设计' },
      { en: 'PCR-amplify fragments with high-fidelity polymerase (Q5 or Phusion). Gel-purify or clean up', zh: '用高保真聚合酶（Q5 或 Phusion）PCR 扩增片段。凝胶纯化或柱纯化' },
      { en: 'On ice, set up reaction: 10 µL Gibson Assembly Master Mix (2×) + DNA fragments (0.02-0.5 pmol for 2-3 fragments; 0.2-1 pmol for 4-6 fragments) + ddH₂O to 20 µL total', zh: '冰上配制反应体系：10 µL Gibson Assembly Master Mix (2×) + DNA 片段（2-3 个片段用 0.02-0.5 pmol；4-6 个片段用 0.2-1 pmol）+ ddH₂O 补至 20 µL' },
      { en: 'Optimal ratio: 3:1 insert:vector molar ratio. Use NEBioCalculator for pmol conversion', zh: '最佳比例：插入片段:载体 = 3:1 摩尔比。用 NEBioCalculator 计算 pmol' },
      { en: 'Incubate at 50°C for 15 min (2-3 fragments) or 60 min (4-6 fragments) in thermocycler', zh: 'PCR 仪中 50°C 孵育 15 min（2-3 个片段）或 60 min（4-6 个片段）' },
      { en: 'Place on ice or store at -20°C', zh: '置于冰上或 -20°C 保存' },
      { en: 'Transform 2 µL of assembly reaction into competent cells (chemical or electroporation)', zh: '取 2 µL 组装产物转化感受态细胞（化学转化或电转）' },
      { en: 'Plate on selective media. Screen colonies by colony PCR or restriction digest', zh: '涂选择性平板。通过菌落 PCR 或酶切筛选克隆' },
