  massPrepSolution: { en: 'solution', zh: '溶液' },
  // Molarity calc descriptive labels
  molMassDesc: { en: 'Mass of solute weighed', zh: '已称溶质质量' },
  molMwDesc: { en: 'Molecular Weight of solute', zh: '溶质分子量' },
  molVolDesc: { en: 'Total solution volume', zh: '溶液总体积' },
  // Percent calc descriptive labels
  pctPercDesc: { en: 'Target percentage', zh: '目标百分比' },
  pctSoluteDescWV: { en: 'Mass of solute to add (w/v)', zh: '需加入溶质质量 (w/v)' },
  pctSoluteDescVV: { en: 'Volume of liquid solute (v/v)', zh: '需加入液体溶质体积 (v/v)' },
  pctVolDesc: { en: 'Total solution volume', zh: '溶液总体积' },
  // Guide tab sections
  guideIntro: { en: 'Quick-start guide to every feature in LabMate.', zh: 'LabMate 各功能快速使用指南。' },
  guideBuffersTitle: { en: 'Buffers & Recipes', zh: '配方库' },
  guideBuffersBody: {
    en: 'Browse verified buffer recipes (PBS, RIPA, Laemmli, etc.) organized by category. Use the Target Volume slider to scale any recipe to your needs. Star recipes to add them to Favorites for quick access. Export individual recipes as TXT or copy to clipboard. Use "Export All" to download every recipe at once.',
    zh: '按分类浏览已验证的缓冲液配方（PBS、RIPA、Laemmli 等）。使用"目标体积"滑块缩放配方。点击星标收藏常用配方。可导出为 TXT 或复制到剪贴板，也可一键"导出全部"。'
  },
  guideProtocolsTitle: { en: 'Protocols', zh: '实验方案' },
  guideProtocolsBody: {
    en: 'Step-by-step protocols for common lab procedures (Western blot, ChIP, RNA extraction, etc.). Each protocol includes a materials list so you can prepare everything before starting. Timers are built in — click any timed step to start a countdown.',
    zh: '常见实验的分步操作方案（Western blot、ChIP、RNA 提取等）。每个方案包含材料清单，可提前准备。内置计时器——点击含时间的步骤即可开始倒计时。'
  },
  guideCalcTitle: { en: 'Calculator', zh: '计算器' },
  guideCalcBody: {
    en: 'Five calculator modes: (1) Dilution — C₁V₁=C₂V₂ with practical pipetting instructions, (2) Mass — how much powder to weigh for a target molarity, (3) Molarity — find the concentration from a known mass, (4) % Solution — w/v or v/v percentage calculations, (5) Prep Calculator — total volume with dead-volume compensation for multi-sample experiments.',
    zh: '五种计算模式：(1) 稀释计算 C₁V₁=C₂V₂ 含实际移液指导，(2) 质量计算——根据目标摩尔浓度算称量量，(3) 摩尔浓度——由已知质量求浓度，(4) 百分比溶液——w/v 或 v/v 计算，(5) 配液计算——多样品实验总量（含 Dead Volume 补偿）。'
  },
  guideGelTitle: { en: 'SDS-PAGE Gel Calculator', zh: 'SDS-PAGE 配胶计算' },
  guideGelBody: {
    en: 'Found inside the Recipes tab under "SDS-PAGE Gel". Choose resolving and stacking gel percentages, set the volume per gel, and specify how many gels. The calculator shows exact volumes of acrylamide, buffer, water, APS, and TEMED. Includes a MW separation range reference table.',
    zh: '位于配方库标签内（点击配胶图标）。选择分离胶和浓缩胶浓度、单胶体积和胶数量，计算器显示丙烯酰胺、缓冲液、水、APS 和 TEMED 的精确用量。附分子量分离范围参考表。'
  },
  guidePlateTitle: { en: 'Plate Designer', zh: '多孔板设计' },
  guidePlateBody: {
    en: 'Design multi-well plate layouts (6, 12, 24, 48, 96, 384-well). Click or drag to select wells, assign labels and colors, then confirm. Use Quick Templates for serial dilution, dose-response, or checkerboard patterns. Export as CSV, SVG image, or copy the layout as text.',
    zh: '设计多孔板布局（6/12/24/48/96/384 孔板）。点击或拖拽选孔，分配标签和颜色后确认。使用快速模板生成梯度稀释、多药物梯度或棋盘格。可导出为 CSV、SVG 图片或复制布局文本。'
  },
  guideShortcutsTitle: { en: 'Keyboard Shortcuts', zh: '键盘快捷键' },
  guideShortcutsBody: {
    en: 'Press ⌘K (Mac) or Ctrl+K (Windows/Linux) to open the global search. Search across all recipes, protocols, reagents, and tags from any tab.',
    zh: '按 ⌘K (Mac) 或 Ctrl+K (Windows/Linux) 打开全局搜索。可在任意标签页搜索所有配方、方案、试剂和标签。'
  },
  guideInventoryTitle: { en: 'Sample Inventory', zh: '样品库存' },
  guideInventoryBody: {
    en: 'Organize lab samples with a hierarchical storage system. Create locations (freezers, fridges, shelves), add boxes (cryo 9×9, 10×10, tip 8×12, etc.), and track samples in a visual grid. Each sample records type, quantity, concentration, passage, dates, owner, and tags. Color-coded by sample type. Export per-box or full inventory as CSV, backup as JSON. All data stored locally in your browser.',
    zh: '使用层级存储系统管理实验室样品。创建存储位置（冰箱、冰柜、架子），添加盒子（冻存盒 9×9、10×10、枪头盒 8×12 等），在可视化网格中追踪样品。每个样品记录类型、数量、浓度、代数、日期、负责人和标签。按样品类型颜色编码。可导出单盒或全部库存为 CSV，备份为 JSON。所有数据存储在浏览器本地。'
  },
  guideRefsCollapse: { en: 'Literature References', zh: '参考文献' },
  guideRefsCollapseDesc: { en: 'Classic papers and manuals cited in this tool', zh: '本工具所引用的经典论文与手册' },
  guideUsageNotesTitle: { en: 'Usage Notes', zh: '使用说明' },
  guideUsageNote1: { en: 'All buffer recipes are from standard lab manuals and classic papers listed below, widely verified.', zh: '所有 buffer 配方均来自下述标准实验手册和经典论文，经广泛验证。' },
  guideUsageNote2: { en: 'SDS-PAGE gel formulas are based on the Laemmli (1970) discontinuous electrophoresis system.', zh: 'SDS-PAGE 配胶公式基于 Laemmli (1970) 不连续凝胶电泳系统。' },
  guideUsageNote3: { en: 'Transfer buffer is based on the classic Towbin (1979) formula.', zh: '转膜液基于 Towbin (1979) 经典配方。' },
  guideUsageNote4: { en: 'DOI links for original literature can be clicked to go directly to publisher pages.', zh: '各配方的原始文献 DOI 可直接点击跳转至出版商页面。' },
  guideUsageNote5: { en: 'Unit conversions in the calculator follow IUPAC standard definitions.', zh: '计算器中的单位换算遵循 IUPAC 标准定义。' },
  guideUsageNote6: { en: 'We recommend verifying against original literature for your specific experimental needs.', zh: '建议配制前根据实际实验需求与文献原文核对。' },
