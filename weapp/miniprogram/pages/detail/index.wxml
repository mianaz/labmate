<wxs module="i" src="../../shared/i18n.wxs"/>
<view class="page page-sub {{timerCount ? 'has-timers' : ''}} lang-{{lang}}">
  <view wx:if="{{missing}}" class="panel empty">
    <view class="empty-icon"><view class="icon i-search"></view></view>
    <view class="empty-title">{{i.t('noResults', lang)}}</view>
    <view class="btn btn-sm" hover-class="is-pressed" bindtap="goHome">{{i.t('backToBuffers', lang)}}</view>
  </view>

  <view wx:elif="{{doc}}" class="panel">
    <!-- Header -->
    <view class="dt-head">
      <view class="row-top between gap-12">
        <view class="row-wrap dt-eyebrows">
          <view class="eyebrow row gap-6" style="color: {{doc.catColor}}"><view class="dot"></view><text>{{doc.catLabel}}</text></view>
          <text wx:if="{{doc.disc}}" class="eyebrow">· {{doc.disc}}</text>
          <text class="badge {{doc.isCustom ? 'badge-green' : ''}}">{{i.t(doc.isCustom ? 'customBadge' : 'systemBadge', lang)}}</text>
        </view>
        <view class="row shrink-0">
          <view class="btn-ghost btn-icon btn-sm {{fav ? 'fav-on' : ''}}" hover-class="is-pressed" bindtap="toggleFav"
            aria-role="button" aria-label="{{fav ? i.t('favRemove', lang) : i.t('favAdd', lang)}}">
            <view class="icon {{fav ? 'i-star-filled' : 'i-star'}}"></view>
          </view>
          <view class="btn-ghost btn-icon btn-sm" hover-class="is-pressed" bindtap="copyText"
            aria-role="button" aria-label="{{i.t('copyClipboard', lang)}}">
            <view class="icon i-copy"></view>
          </view>
          <button class="btn-ghost btn-icon btn-sm" open-type="share" hover-class="is-pressed" aria-label="{{lang === 'zh' ? '分享' : 'Share'}}">
            <view class="icon i-arrow-up-right"></view>
          </button>
        </view>
      </view>
      <view class="dt-title">{{doc.name}}</view>
      <view wx:if="{{doc.nameCn}}" class="dt-subtitle">{{doc.nameCn}}</view>
      <view wx:if="{{doc.usage}}" class="dt-usage">{{doc.usage}}</view>

      <view wx:if="{{doc.related.length}}" class="row-wrap gap-6 mt-12">
        <text class="eyebrow dt-usedin">{{i.t('usedInLabel', lang)}}</text>
        <block wx:for="{{doc.related}}" wx:key="id">
          <view wx:if="{{showAllRelated || index < doc.relatedPreview}}" class="chip is-link" hover-class="is-pressed" data-id="{{item.id}}" bindtap="openRecipe">
            <text>{{item.name}}</text><view class="icon i-arrow-right"></view>
          </view>
        </block>
        <view wx:if="{{doc.relatedMore}}" class="chip is-dashed" hover-class="is-pressed" bindtap="toggleRelated">
          {{showAllRelated ? (lang === 'zh' ? '收起' : 'Show less') : ('+' + doc.relatedMore + (lang === 'zh' ? ' 更多' : ' more'))}}
        </view>
      </view>

      <view wx:if="{{doc.isCustom}}" class="row gap-8 mt-12">
        <view class="btn btn-sm" hover-class="is-pressed" bindtap="editCustom"><view class="icon i-edit"></view><text>{{i.t('editCustom', lang)}}</text></view>
        <view class="btn-danger btn-sm" hover-class="is-pressed" bindtap="deleteCustom"><view class="icon i-trash"></view><text>{{i.t('deleteCustom', lang)}}</text></view>
      </view>
    </view>

    <!-- Facts -->
    <view wx:if="{{doc.facts.length}}" class="meta-grid">
      <view wx:for="{{doc.facts}}" wx:key="k" class="meta-cell {{item.wide ? 'is-wide' : ''}} {{item.right ? 'is-right' : ''}}">
        <view class="meta-key">{{item.k}}</view>
        <view class="meta-val">{{item.v}}</view>
      </view>
    </view>

    <view class="dt-body">
      <!-- SDS-PAGE: inline gel calculator -->
      <view wx:if="{{doc.isGel}}" class="doc-section">
        <gel-calc />
      </view>

      <!-- Materials -->
      <view wx:if="{{doc.materials.length}}" class="doc-section">
        <view class="doc-section-head"><text class="eyebrow dt-section-title">{{i.t('materialsLabel', lang)}}</text></view>
        <view wx:for="{{doc.materials}}" wx:key="index" class="dt-material">
          <view class="dt-bullet"></view>
          <view class="flex-1">
            <text wx:if="{{item.linkedId}}" class="link" data-id="{{item.linkedId}}" bindtap="openRecipe">{{item.name}} ↗</text>
            <text wx:else>{{item.name}}</text>
            <view wx:if="{{item.note}}" class="dt-material-note">{{item.note}}</view>
          </view>
        </view>
      </view>

      <!-- Brief / detailed steps -->
      <view wx:if="{{doc.hasStepToggle}}" class="doc-section">
        <view class="doc-section-head">
          <text class="eyebrow dt-section-title">{{i.t('stepsLabel', lang)}}</text>
          <view class="row gap-8">
            <view class="chip {{keepAwake ? 'is-active' : ''}}" hover-class="is-pressed" bindtap="toggleKeepAwake">
              <view class="icon i-sun"></view><text>{{i.t('keepScreenOn', lang)}}</text>
            </view>
            <view class="seg">
              <view class="seg-item {{!showDetailed ? 'is-active' : ''}}" data-mode="brief" bindtap="setStepMode">{{i.t('briefLabel', lang)}}</view>
              <view class="seg-item {{showDetailed ? 'is-active' : ''}}" data-mode="detailed" bindtap="setStepMode">{{i.t('detailedLabel', lang)}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{!showDetailed}}" class="notice notice-info dt-brief">
          <view>
            <view wx:for="{{doc.briefSteps}}" wx:key="index" class="dt-brief-line">{{item}}</view>
          </view>
        </view>

        <block wx:else>
          <view wx:if="{{doc.actionCount}}" class="dt-progress">
            <text class="mono dt-progress-label">{{i.t('stepProgress', lang)}} <text class="strong dt-progress-count">{{doneCount}}/{{doc.actionCount}}</text></text>
            <view class="flex-1 dt-progress-track"><view class="dt-progress-fill" style="width: {{doneCount / doc.actionCount * 100}}%"></view></view>
            <view wx:if="{{doneCount}}" class="btn-ghost btn-sm" hover-class="is-pressed" bindtap="resetSteps">{{i.t('stepReset', lang)}}</view>
          </view>
          <view class="dt-steps">
            <block wx:for="{{doc.steps}}" wx:key="i">
              <view wx:if="{{item.header}}" class="dt-step-header {{index > 0 ? 'has-rule' : ''}}">
                <text wx:for="{{item.segs}}" wx:for-item="seg" wx:for-index="si" wx:key="si" class="{{seg.bold ? 'strong' : ''}}">{{seg.text}}</text>
              </view>
              <view wx:else class="dt-step {{done[item.i] ? 'is-done' : ''}}">
                <view class="dt-check-hit" data-i="{{item.i}}" bindtap="toggleStep" aria-role="checkbox" aria-checked="{{!!done[item.i]}}">
                  <view class="checkbox {{done[item.i] ? 'is-checked' : ''}}"><view wx:if="{{done[item.i]}}" class="icon i-check"></view></view>
                </view>
                <view class="flex-1">
                  <view class="dt-step-text" data-i="{{item.i}}" bindtap="toggleStep">
                    <text wx:for="{{item.segs}}" wx:for-item="seg" wx:for-index="si" wx:key="si" class="{{seg.bold ? 'strong' : ''}}">{{seg.text}}</text>
                  </view>
                  <view wx:if="{{item.timers.length}}" class="row-wrap gap-6 mt-4">
                    <view wx:for="{{item.timers}}" wx:for-item="tm" wx:for-index="ti" wx:key="ti" class="btn btn-sm mono dt-timer-btn" hover-class="is-pressed"
                      data-seconds="{{tm.seconds}}" data-label="{{tm.label}}" catchtap="startTimer">
                      <view class="icon i-timer"></view><text>{{tm.label}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.safeStop}}" class="notice notice-warn dt-safe">
                <view class="icon i-pause dt-safe-icon"></view>
                <view><text class="notice-title">{{i.t('safeStop', lang)}}</text><text class="muted"> {{item.safeStop}}</text></view>
              </view>
            </block>
          </view>
        </block>
      </view>

      <!-- Legacy / custom protocol steps -->
      <view wx:if="{{doc.isProtocol && !doc.hasStepToggle}}" class="doc-section">
        <view class="doc-section-head">
          <text class="eyebrow dt-section-title">{{i.t('stepsLabel', lang)}}</text>
          <view class="chip {{keepAwake ? 'is-active' : ''}}" hover-class="is-pressed" bindtap="toggleKeepAwake">
            <view class="icon i-sun"></view><text>{{i.t('keepScreenOn', lang)}}</text>
          </view>
        </view>
        <view class="timeline">
          <view wx:for="{{doc.legacySteps}}" wx:key="index" class="step {{item.sub ? 'is-sub' : ''}}">
            <text>{{item.name}}</text>
            <text wx:if="{{item.amountText}}" class="step-amount"> {{item.amountText}}</text>
            <text wx:if="{{item.note}}" class="step-note">{{item.note}}</text>
          </view>
        </view>
      </view>

      <!-- Components table with volume scaling -->
      <view wx:if="{{doc.showComponentsTable}}" class="doc-section">
        <view class="doc-section-head dt-comp-head">
          <text class="eyebrow dt-section-title">{{i.t('componentsLabel', lang)}}</text>
        </view>
        <view class="row-wrap gap-8 dt-scale">
          <text class="field-label dt-scale-label">{{i.t('targetVolume', lang)}}</text>
          <view class="input-group dt-vol">
            <input class="input is-sm tabular" type="digit" value="{{targetVol}}" bindinput="onVolume" bindblur="onVolumeBlur" aria-label="{{i.t('targetVolume', lang)}}" />
            <view class="input-addon">{{doc.unit}}</view>
          </view>
          <view class="seg">
            <view wx:for="{{presets}}" wx:key="m" class="seg-item {{item.active ? 'is-active' : ''}}" data-m="{{item.m}}" bindtap="setPreset">{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{scaleText}}" class="mono dt-scale-text">{{scaleText}}</view>
        <view class="table">
          <view class="tr is-head">
            <view class="th flex-1">{{i.t('reagent', lang)}}</view>
            <view class="th dt-col-amt">{{i.t('amount', lang)}}</view>
            <view class="th dt-col-unit">{{i.t('unit', lang)}}</view>
          </view>
          <view wx:for="{{components}}" wx:key="index" class="tr dt-comp-row">
            <view class="td flex-1">
              <text wx:if="{{item.linkedId}}" class="link" data-id="{{item.linkedId}}" bindtap="openRecipe">{{item.name}}</text>
              <text wx:else class="dt-comp-name">{{item.name}}</text>
              <view wx:if="{{item.note}}" class="dt-comp-note">{{item.note}}</view>
            </view>
            <view class="td is-num dt-col-amt">{{item.amount}}</view>
            <view class="td is-unit dt-col-unit">{{item.unit}}</view>
          </view>
        </view>
      </view>

      <!-- Preparation -->
      <view wx:if="{{prep.length}}" class="doc-section">
        <view class="doc-section-head">
          <text class="eyebrow dt-section-title">{{i.t('prepStepsLabel', lang)}}</text>
          <view class="chip {{keepAwake ? 'is-active' : ''}}" hover-class="is-pressed" bindtap="toggleKeepAwake">
            <view class="icon i-sun"></view><text>{{i.t('keepScreenOn', lang)}}</text>
          </view>
        </view>
        <view class="timeline">
          <view wx:for="{{prep}}" wx:key="index" class="step"><text>{{item}}</text></view>
        </view>
      </view>

      <view wx:if="{{doc.note}}" class="notice mt-24">
        <view class="icon i-info dt-note-icon"></view>
        <view><text class="notice-title">{{i.t('tip', lang)}}: </text><text>{{doc.note}}</text></view>
      </view>
      <view wx:if="{{doc.ref}}" class="mono dt-ref">
        <text class="eyebrow dt-ref-label">{{i.t('referenceLabel', lang)}} </text><text user-select>{{doc.ref}}</text>
      </view>
    </view>
  </view>
</view>
<timer-bar />
