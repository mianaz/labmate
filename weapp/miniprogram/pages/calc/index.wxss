/* Calculator switcher: one horizontally scrolling row that runs to the screen
   edges (the page has 16px gutters). */
.cx-switch { margin-bottom: 16px; }
.cx-switch-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.cx-switch-count { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }
.cx-switch-scroll { width: calc(100% + 32px); margin: 0 -16px; white-space: nowrap; overflow: hidden; }
.cx-switch-track { display: inline-flex; gap: 6px; padding: 0 16px 3px; }

.cx-mode {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
  min-height: 52px;
  padding: 7px 12px;
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--text);
}
.cx-mode.is-pressed { background: var(--bg-2); }
.cx-mode.is-active {
  background: var(--primary);
  border-color: var(--border-strong);
  color: var(--on-primary);
  box-shadow: var(--shadow-sm);
}
.cx-mode-task { font-size: 13px; font-weight: 700; line-height: 1.3; white-space: nowrap; }
.cx-mode-formula {
  margin-top: 2px;
  font-family: var(--font-mono);
  font-size: 11px;
  line-height: 1.3;
  white-space: nowrap;
  color: var(--text-muted);
}
.cx-mode.is-active .cx-mode-formula { color: var(--on-primary); opacity: 0.75; }
