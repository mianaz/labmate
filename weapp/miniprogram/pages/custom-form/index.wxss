.cf-section { margin: 20px 0 8px; padding-bottom: 6px; border-bottom: 1px solid var(--rule); color: var(--text); }
.cf-comp { padding: 8px 0; border-bottom: 1px dashed var(--rule); }
.cf-amount { width: 84px; flex-shrink: 0; }
.cf-unit { width: 64px; flex-shrink: 0; }
.cf-step { padding: 6px 0; }
.cf-step-n { font-size: 12px; font-weight: 700; color: var(--text-muted); min-width: 22px; padding-top: 9px; text-align: right; }
.cf-mat { padding: 3px 0; }
.textarea { min-height: 72px; height: auto; }
.cf-step-ta { min-height: 38px; height: auto; padding: 8px 10px; font-size: 14px; }
