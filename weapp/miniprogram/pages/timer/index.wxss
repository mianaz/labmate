.tm-custom { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--rule); }
.tm-item { padding: 12px 14px; margin-bottom: 10px; }
.tm-item.is-done { background: var(--primary-light); border-color: var(--primary); }
.tm-label { font-size: 15px; font-weight: 600; }
.tm-time { font-size: 26px; font-weight: 700; }
.tm-item.is-done .tm-time { color: var(--accent); font-size: 18px; }
.tm-track { height: 4px; background: var(--bg-2); margin-top: 8px; }
.tm-fill { height: 100%; background: var(--primary); }
.tm-fill.is-paused { background: var(--border); }
.tm-finished { margin-top: 4px; font-size: 12px; color: var(--text-muted); }
.tm-note { font-size: 13px; }
.tm-note-icon { margin-top: 3px; font-size: 14px; }
