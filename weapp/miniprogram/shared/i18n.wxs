"],"agentUnverifiedValues":["Values not from a tool — double-check","数值未经工具核实，请复核"],"agentYou":["You","你"],"all":["All","全部"],"allProtocolsBack":["All protocols","全部方案"],"allRecipesBack":["All recipes","全部配方"],"amount":["Amount","用量"],"appSubtitle":[""],"appTitle":["bioinfospace labmate"],"backLabel":["Back","返回"],"backNav":["Back","返回"],"backToBuffers":["Back to recipes","返回配方列表"],"backupAction":["Back up","备份"],"backupDaysAgo":["{n} d ago","{n} 天前"],"backupDone":["Backup downloaded","备份已下载"],"backupDueDesc":["Everything is stored only in this browser.","所有数据仅保存在此浏览器中。"],"backupDueTitle":["Back up your data","请备份您的数据"],"backupFailed":["Backup failed","备份失败"],"backupLast":["Last backup","上次备份"],"backupLater":["Later","稍后"],"backupNever":["never","从未"],"backupNow":["Backup Now","立即备份"],"backupReminder":["Your data is stored locally in this browser only. Back up regularly to avoid data loss.","您的数据仅存储在此浏览器中。请定期备份以防数据丢失。"],"backupToday":["today","今天"],"bestRange":["Best Separation Range (kDa)","最佳分离范围 (kDa)"],"briefLabel":["Brief","简要"],"buffer":["Buffer"],"calApr":["April","四月"],"calAug":["August","八月"],"calColor":["Color","颜色"],"calDec":["December","十二月"],"calDeleteEvent":["Delete","删除"],"calEditEvent":["Edit Experiment","编辑实验"],"calEventForm":["Experiment Details","实验详情"],"calExportIcs":["Export .ics","导出 .ics"],"calFeb":["February","二月"],"calFri":["Fri","五"],"calIcsExported":["Calendar exported as .ics","日历已导出为 .ics"],"calIcsFrom":["From","从"],"calIcsTo":["To","到"],"calImportProtocol":["Import from Protocol","从方案导入"],"calJan":["January","一月"],"calJul":["July","七月"],"calJun":["June","六月"],"calMar":["March","三月"],"calMay":["May","五月"],"calMon":["Mon","一"],"calMonthView":["Month","月视图"],"calNewEvent":["New Experiment","新建实验"],"calNoEvents":["No experiments scheduled","暂无实验安排"],"calNov":["November","十一月"],"calOct":["October","十月"],"calOpenInNotebook":["Open in Notebook","在记录本中打开"],"calSat":["Sat","六"],"calSelectProtocol":["Select a protocol...","选择方案..."],"calSep":["September","九月"],"calSubtitle":["Plan and schedule experiments with protocol integration","规划和安排实验，支持方案集成"],"calSun":["Sun","日"],"calThu":["Thu","四"],"calTitle":["Experiment Calendar","实验日历"],"calToday":["Today","今天"],"calTue":["Tue","二"],"calWed":["Wed","三"],"calWeekHours":["hours","时"],"calWeekView":["Week","周视图"],"calcError":["Error","错误"],"calcKeyboardHint":["Keyboard: digits, + − * / ^ ( ) . Enter = equals, Esc = clear, Backspace = delete.","键盘：数字、+ − * / ^ ( ) . 回车 = 等于，Esc = 清除，退格 = 删除。"],"calcSubtitle":["Dilution, mass, molarity, and percentage calculations","支持稀释、质量、摩尔浓度和百分比溶液计算"],"calcTaskConvert":["Unit Conversion","单位换算"],"calcTaskDeadVol":["Dead Volume Calculator","损耗体积计算器"],"calcTaskDilution":["Dilution Calculator","稀释计算器"],"calcTaskGel":["SDS-PAGE gel recipe","SDS-PAGE 配胶"],"calcTaskMW":["MW Calculator","分子量计算器"],"calcTaskMass":["Mass Calculator","质量计算器"],"calcTaskMolarity":["Molarity Calculator","摩尔浓度计算器"],"calcTaskPercent":["Percent Calculator","百分比计算器"],"calcTaskPeriodic":["Periodic Table","元素周期表"],"calcTaskScientific":["Scientific Calculator","科学计算器"],"calcTitle":["Solution Calculator","溶液计算器"],"catCellAssay":["Cell Assay","细胞实验"],"catCellCulture":["Cell Culture","细胞培养"],"catCloning":["Cloning","克隆"],"catNucleicAcid":["Nucleic Acid","核酸"],"catProtein":["Protein","蛋白"],"checkerboard":["Checkerboard","棋盘格"],"clearAll":["Clear All","清空全部"],"closeLabel":["Close","关闭"],"color":["Color","颜色"],"commonMW":["Common MW Reference","常用 MW 速查"],"componentsLabel":["Components","组分"],"confirmMark":["Confirm","确认标记"],"contains":["Contains","含有"],"convertCalcDesc":["Convert between volume, mass, length, temperature and pressure units.","在体积、质量、长度、温度和压力单位之间换算。"],"convertCatConc":["Concentration","浓度"],"convertCatLength":["Length","长度"],"convertCatMass":["Mass","质量"],"convertCatPressure":["Pressure","压力"],"convertCatTemp":["Temperature","温度"],"convertCatVolume":["Volume","体积"],"convertCategory":["Category","类别"],"convertFrom":["From","从"],"convertResult":["Result","结果"],"convertTo":["To","到"],"copied":["Copied to clipboard!","已复制到剪贴板！"],"copyClipboard":["Copy to Clipboard","复制到剪贴板"],"copyLayout":["Copy Layout","复制布局文本"],"customBadge":["Custom","自定义"],"customFilter":["My Recipes","我的配方"],"customFormAddComponent":["Add Component","添加组分"],"customFormAddMaterial":["Add Material","添加材料"],"customFormAddStep":["Add Step","添加步骤"],"customFormCancel":["Cancel","取消"],"customFormCategory":["Category","分类"],"customFormCompAmount":["Amount","用量"],"customFormCompName":["Reagent Name","试剂名"],"customFormCompNote":["Note","备注"],"customFormCompUnit":["Unit","单位"],"customFormComponents":["Components","组分"],"customFormDefaultVol":["Default Volume","默认体积"],"customFormMaterials":["Materials","材料"],"customFormName":["Name","名称"],"customFormNameCn":["Chinese Name (optional)","中文名（可选）"],"customFormNotes":["Notes","备注"],"customFormNotesEn":["Notes (EN)","备注（英文）"],"customFormNotesZh":["Notes (ZH)","备注（中文）"],"customFormPH":["pH (optional)","pH（可选）"],"customFormSave":["Save","保存"],"customFormStepTextEn":["Step (EN)","步骤（英文）"],"customFormStepTextZh":["Step (ZH)","步骤（中文）"],"customFormSteps":["Steps","步骤"],"customFormStorageDuration":["Storage Duration","保存时间"],"customFormStorageLabelEn":["Storage Label (EN)","储存说明（英文）"],"customFormStorageLabelZh":["Storage Label (ZH)","储存说明（中文）"],"customFormStorageTemp":["Storage Temp","储存温度"],"customFormTags":["Tags (comma-separated)","标签（逗号分隔）"],"customFormUnit":["Unit","单位"],"customPreset":["Custom","自定义"],"darkMode":["Dark","深色"],"deadVolAmount":["Dead volume portion","余量部分"],"deadVolDesc":["Compute how much buffer or reagent to prepare, accounting for extra volume lost to pipetting and dead space.","计算实验所需配液量，自动加入移液与管路死体积的补偿量。"],"deadVolPercent":["Dead volume (%)","损耗比例 (%)"],"deadVolSubtitle":["Calculate total volume to prepare with dead volume compensation","根据样品数和用量计算总配制量（含 Dead Volume 补偿）"],"deadVolTip":["Typical dead volume: 10–20% for multichannel pipetting, 15–25% for master mix","一般建议：多通道移液 10–20%，Master Mix 15–25%"],"deadVolTitle":["Preparation Volume Calculator","实验配液量计算器"],"defaultVolLabel":["Base volume","基准体积"],"deleteConfirm":["Delete this item? This cannot be undone.","删除此项？此操作不可撤销。"],"deleteCustom":["Delete","删除"],"detailedLabel":["Detailed","详细"],"dilC1Desc":["Stock Concentration","母液浓度"],"dilC2Desc":["Desired (Target) Concentration","目标浓度"],"dilPrepAdd":["then add","再加入"],"dilPrepDilute":["Dilute your stock to","将母液稀释至"],"dilPrepFinalVol":["final volume","终体积"],"dilPrepFrom":["from","取自"],"dilPrepNeedStock":["You need a stock at","需要母液浓度为"],"dilPrepPipette":["Pipette","取"],"dilPrepReach":["to reach","至总体积"],"dilPrepSolvent":["of solvent (water/buffer)","溶剂（水/缓冲液）"],"dilPrepStock":["of stock solution","母液"],"dilPrepSummary":["How to prepare","配制方法"],"dilPrepToGet":["to get","以获得"],"dilPrepTotal":["total"],"dilPrepUsing":["using","使用"],"dilV1Desc":["Volume of Stock to Pipette","需取母液体积"],"dilV2Desc":["Total Final Volume","最终总体积"],"dilution":["Dilution","稀释计算"],"dilutionCalcDesc":["Solve C₁V₁ = C₂V₂ for any unknown — concentration or volume, stock or working solution.","根据 C₁V₁ = C₂V₂ 求解任一未知量——母液/工作液的浓度或体积均可。"],"dilutionFormula":["C₁V₁ = C₂V₂ Dilution Formula","C₁V₁ = C₂V₂ 稀释公式"],"discBiochemistry":["Biochemistry","生物化学"],"discCell":["Cell Biology","细胞生物学"],"discGeneral":["General","通用"],"discGenomics":["Genomics","基因组学"],"discHistology":["Histology","组织学"],"discImmunology":["Immunology","免疫学"],"discMicrobiology":["Microbiology","微生物学"],"discMolecular":["Molecular","分子生物学"],"discProtein":["Protein","蛋白质"],"discRnaDna":["RNA/DNA"],"dismissReminder":["Dismiss","忽略"],"doseNumDrugs":["Number of drugs/conditions","药物/条件数"],"doseResponse":["Dose-Response","多药物梯度"],"downloadCSV":["Download CSV","下载 CSV"],"downloadGel":["Download Recipe","下载配胶方案"],"downloadSVG":["Download SVG","下载 SVG 图"],"downloadTxt":["Download TXT","下载 TXT"],"downloaded":["File downloaded","文件已下载"],"durationLabel":["Duration","时长"],"editCustom":["Edit","编辑"],"enterOther3":["Enter the other 3 values","输入其他三个值"],"expired":["Expired","已过期"],"expiringSoon":["Expiring soon","即将过期"],"exportAll":["Export All","导出全部"],"exportBtn":["Download Backup","下载备份"],"exportDesc":["Download all your favorites, step progress, notebook entries, and settings as a single JSON file. Use this to back up your data or transfer to another device.","将所有收藏、实验进度、实验记录和设置导出为一个 JSON 文件。用于数据备份或转移到其他设备。"],"exportPlate":["Export Layout","导出板布局"],"exportTitle":["Export My Data","导出我的数据"],"favAdd":["Add to favorites","加入收藏"],"favRemove":["Remove from favorites","取消收藏"],"favorites":["Favorites","收藏"],"finalVol":["Final Volume (mL)","终体积 (mL)"],"gelCalcMode":["SDS-PAGE Gel Calculator","SDS-PAGE 配胶计算"],"gelConc":["Gel %","胶浓度"],"gelCount":["Gels","胶数"],"gelResolving":["Resolving Gel","分离胶"],"gelResolvingPct":["Resolving %","分离胶 %"],"gelResolvingVol":["Vol/gel (mL)","体积/胶 (mL)"],"gelSafety1":["Acrylamide is a neurotoxin — wear gloves!","丙烯酰胺是神经毒素——务必戴手套！"],"gelSafety2":["Prepare 10% APS fresh each time","10% APS 需现配现用"],"gelSafety3":["Add TEMED last — polymerization starts immediately","TEMED 最后加——加入后立即开始聚合"],"gelSafety4":["Overlay with isopropanol/water-saturated butanol for flat interface","灌胶后用异丙醇/水饱和正丁醇覆盖，保证界面平整"],"gelSafety5":["Pre-run gel 15 min at 80V to remove free radicals","预电泳 15 min (80V) 以去除多余自由基"],"gelSafetyTitle":["Safety & Tips","操作注意事项"],"gelStacking":["Stacking Gel","浓缩胶"],"gelStackingPct":["Stacking %","浓缩胶 %"],"gelStackingVol":["Vol/gel (mL)","体积/胶 (mL)"],"gelSubtitle":["Laemmli discontinuous electrophoresis system","Laemmli 不连续电泳系统配胶计算器"],"gelTitle":["SDS-PAGE Gel Calculator","SDS-PAGE 配胶计算器"],"gelTotal":["Total","总量"],"guideAgentBody":["An optional AI planning assistant (toggle with ⌘J / Ctrl+J). Describe an experiment in plain language and it can find a protocol, scale a recipe, run a calculation, and draft a notebook or calendar entry — always asking before it writes anything. It is retrieval-only: steps, reagents, and numbers come from the curated library and the app's own calculators, never invented by the language model. Two caveats: it only appears when the site owner has configured a model key server-side (if you don't see it, that is expected), and — unlike everything else in labmate — using it sends the messages you type to that server-side model to generate a reply.","可选的 AI 实验规划助手（快捷键 ⌘J / Ctrl+J）。用自然语言描述实验，它能检索方案、缩放配方、执行计算，并起草实验记录或日历条目——写入前始终会先征询你。它仅做检索：步骤、试剂与数据均取自精选库和应用自带计算器，绝不由语言模型编造。两点说明：仅当站点管理员在服务器端配置了模型密钥时才会出现（看不到属正常）；且——与 labmate 其他功能不同——使用它会将你输入的消息发送到该服务器端模型以生成回复。"],"guideAgentTitle":["AI Assistant","AI 智能助手"],"guideBuffersBody":["Browse verified buffer recipes (PBS, RIPA, Laemmli, etc.) organized by discipline. Type a target volume or tap ×½ / ×2 / ×5 to scale any recipe — amounts and preparation steps update together. Star recipes to add them to Favorites; filter by discipline, favorites or your own custom recipes. From a recipe's detail view, download the scaled recipe as TXT or copy it to clipboard. Recently viewed recipes appear at the top.","按学科分类浏览已验证的缓冲液配方（PBS、RIPA、Laemmli 等）。输入目标体积或点击 ×½ / ×2 / ×5 即可换算配方，用量与配制步骤同步更新。点击星标收藏常用配方；可按学科、收藏或自定义筛选。在配方详情页可将缩放后的配方下载为 TXT 或复制到剪贴板。最近查看的配方会置顶显示。"],"guideBuffersTitle":["Recipes","配方库"],"guideCalcBody":["Nine calculators: Dilution (C₁V₁=C₂V₂ with practical pipetting instructions), Mass (how much powder to weigh for a target molarity), Molarity (concentration from a known mass), Percent (w/v or v/v), Dead volume (master-mix totals with overage), Unit conversion, Molecular weight from a formula, a Periodic table, and a Scientific calculator. A basic quick calculator is always one click away in the sidebar (top bar on phones).","九种计算器：稀释（C₁V₁=C₂V₂，含实际移液指导）、质量（按目标摩尔浓度计算称量量）、摩尔浓度（由已知质量求浓度）、百分比（w/v 或 v/v）、配液余量（多样品总量含损耗补偿）、单位换算、分子式求分子量、元素周期表与科学计算器。侧边栏（手机上为顶部栏）另有随时可用的快速计算器。"],"guideCalcTitle":["Calculator","计算器"],"guideCalendarBody":["Month or week view of all notebook entries, color-coded by status. Click an empty day to schedule a new experiment; click an existing event to edit. Navigate months with the arrows or jump to Today. Export a date range as an ICS file to import into Google/Apple Calendar. Share a notebook entry with Calendar via the \"Open Calendar\" button in the Notebook tab.","按月或按周查看所有记录本条目，按状态颜色编码。点击空白日期可新建实验；点击已有条目可编辑。使用箭头切换月份或点击\"今天\"跳转。可将一段日期范围导出为 ICS 文件导入 Google/Apple 日历。也可在记录本标签页点击\"打开日历\"跳转至对应条目。"],"guideCalendarTitle":["Experiment Calendar","实验日历"],"guideCustomBody":["Create your own buffer recipes or protocols using the \"New Recipe\" / \"New Protocol\" buttons on the Recipes and Protocols pages. Custom items are labeled with a \"Custom\" badge and appear alongside system recipes. Edit or delete them anytime. Custom recipes are included in data exports.","使用「配方库」和「实验方案」页面中的\"新建配方\"/\"新建方案\"按钮创建自定义配方或方案。自定义条目带有\"自定义\"标记，与系统配方并列显示。可随时编辑或删除。自定义配方包含在数据导出中。"],"guideCustomTitle":["Custom Recipes & Protocols","自定义配方和实验方案"],"guideDataSafetyBody":["All your data (favorites, inventory, custom recipes, step progress) is stored in your browser's IndexedDB (with localStorage as fallback). Clearing browser data, switching browsers, or using private/incognito mode will erase everything. Export your data regularly from the Guide tab to keep a backup.","所有数据（收藏、库存、自定义配方、步骤进度）均存储在浏览器的 IndexedDB 中（localStorage 作为备用）。清除浏览器数据、更换浏览器或使用隐私/无痕模式将删除所有数据。请定期从指南标签页导出数据作为备份。"],"guideDataSafetyTitle":["Data Safety","数据安全"],"guideGelBody":["Found inside the Recipes tab under \"SDS-PAGE Gel\". Choose resolving and stacking gel percentages, set the volume per gel, and specify how many gels. The calculator shows exact volumes of acrylamide, buffer, water, APS, and TEMED. Includes a MW separation range reference table.","位于配方库标签内（点击配胶图标）。选择分离胶和浓缩胶浓度、单胶体积和胶数量，计算器显示丙烯酰胺、缓冲液、水、APS 和 TEMED 的精确用量。附分子量分离范围参考表。"],"guideGelTitle":["SDS-PAGE Gel Calculator","SDS-PAGE 配胶计算"],"guideIntro":["Quick-start guide to every feature in labmate.","labmate 各功能快速使用指南。"],"guideInventoryBody":["Organize lab samples with a hierarchical storage system. Create locations (freezers, fridges, shelves), add boxes (cryo 9×9, 10×10, tip 8×12, etc.), and track samples in a visual grid. Each sample records type, quantity, concentration, passage, dates, owner, and tags. Color-coded by sample type. Export per-box or full inventory as CSV, backup as JSON. All data stored locally in your browser.","使用层级存储系统管理实验室样品。创建存储位置（冰箱、冰柜、架子），添加盒子（冻存盒 9×9、10×10、枪头盒 8×12 等），在可视化网格中追踪样品。每个样品记录类型、数量、浓度、代数、日期、负责人和标签。按样品类型颜色编码。可导出单盒或全部库存为 CSV，备份为 JSON。所有数据存储在浏览器本地。"],"guideInventoryTitle":["Sample Inventory","样品库存"],"guideNotebookBody":["Digital lab notebook with auto-save. Create dated entries with plan, materials, step-by-step procedure, and results sections. Import steps from any protocol recipe to prefill the procedure. Link reagents from your Inventory to track what you used. Filter by status (planned / in-progress / completed / cancelled). Jump to the Calendar view to see entries laid out by date.","带自动保存的电子实验记录本。创建按日期的条目，含计划、材料、分步流程和结果四大板块。可从任意实验方案配方导入步骤自动填充流程。可关联库存中的试剂以追踪实际用量。按状态筛选（计划中 / 进行中 / 已完成 / 已取消）。可切换至日历视图按日期查看条目。"],"guideNotebookTitle":["Lab Notebook","实验记录本"],"guidePlateBody":["Design multi-well plate layouts (6, 12, 24, 48, 96, 384-well). Click or drag to select wells, assign labels and colors, then confirm. Use Quick Templates for serial dilution, dose-response, or checkerboard patterns. Export as CSV, SVG image, or copy the layout as text.","设计多孔板布局（6/12/24/48/96/384 孔板）。点击或拖拽选孔，分配标签和颜色后确认。使用快速模板生成梯度稀释、多药物梯度或棋盘格。可导出为 CSV、SVG 图片或复制布局文本。"],"guidePlateTitle":["Plate Designer","多孔板设计"],"guideProtocolsBody":["Step-by-step protocols for common lab procedures (Western blot, ChIP, RNA extraction, etc.). Each protocol includes a materials list so you can prepare everything before starting. Timers are built in — click any timed step to start a countdown.","常见实验的分步操作方案（Western blot、ChIP、RNA 提取等）。每个方案包含材料清单，可提前准备。内置计时器——点击含时间的步骤即可开始倒计时。"],"guideProtocolsTitle":["Protocols","实验方案"],"guideRefsCollapse":["Literature References","参考文献"],"guideRefsCollapseDesc":["Classic papers and manuals cited in this tool","本工具所引用的经典论文与手册"],"guideShortcutsBody":["Press ⌘K (Mac) or Ctrl+K (Windows/Linux) to open the global search. Search across all recipes, protocols, reagents, and tags from any page; use ↑ / ↓ and Enter to open a result. ⌘J / Ctrl+J toggles the AI assistant when it is available.","按 ⌘K (Mac) 或 Ctrl+K (Windows/Linux) 打开全局搜索。可在任意页面搜索所有配方、方案、试剂和标签，用 ↑ / ↓ 与回车打开结果。AI 助手可用时，⌘J / Ctrl+J 可切换助手面板。"],"guideShortcutsTitle":["Keyboard Shortcuts","键盘快捷键"],"guideToolsBody":["Curated directory of external bioinformatics resources grouped by category: sequencing analysis, primer design, protein/structure databases, genome browsers, pathway tools, single-cell atlases, and more. Filter by category to narrow the list. Each card opens the external site in a new tab.","精选的外部生物信息学资源目录，按类别分组：测序分析、引物设计、蛋白/结构数据库、基因组浏览器、通路工具、单细胞图谱等。可按类别筛选。每张卡片点击后在新标签页打开外部站点。"],"guideToolsTitle":["External Tools & Data Hub","外部工具 & 数据中心"],"guideUsageNote1":["All buffer recipes are from standard lab manuals and classic papers listed below, widely verified.","所有 buffer 配方均来自下述标准实验手册和经典论文，经广泛验证。"],"guideUsageNote2":["SDS-PAGE gel formulas are based on the Laemmli (1970) discontinuous electrophoresis system.","SDS-PAGE 配胶公式基于 Laemmli (1970) 不连续凝胶电泳系统。"],"guideUsageNote3":["Transfer buffer is based on the classic Towbin (1979) formula.","转膜液基于 Towbin (1979) 经典配方。"],"guideUsageNote4":["DOI links for original literature can be clicked to go directly to publisher pages.","各配方的原始文献 DOI 可直接点击跳转至出版商页面。"],"guideUsageNote5":["Unit conversions in the calculator follow IUPAC standard definitions.","计算器中的单位换算遵循 IUPAC 标准定义。"],"guideUsageNote6":["We recommend verifying against original literature for your specific experimental needs.","建议配制前根据实际实验需求与文献原文核对。"],"guideUsageNotesTitle":["Usage Notes","使用说明"],"hideList":["Hide list","隐藏列表"],"importBtn":["Choose File","选择文件"],"importDesc":["Restore data from a previous export. This will merge with your current data (existing items will be overwritten if they conflict).","从之前的导出文件恢复数据。将与当前数据合并（冲突项将被覆盖）。"],"importError":["Invalid backup file","备份文件格式无效"],"importSuccess":["Restored {n} items","已恢复 {n} 项数据"],"importTitle":["Import Data","导入数据"],"invAddBox":["Add Box","添加盒子"],"invAddLocation":["Add Location","添加位置"],"invAddSample":["Add Sample","添加样品"],"invAllSamples":["All Samples","全部样品"],"invApply":["Apply","应用"],"invBoxContents":["Box Contents","盒子内容"],"invBoxCryo100":["10x10 Cryo Box (100)","10x10 冻存盒 (100)"],"invBoxCryo81":["9x9 Cryo Box (81)","9x9 冻存盒 (81)"],"invBoxCustom":["Custom","自定义"],"invBoxSlide":["Slide Box (1x25)","载玻片盒 (1x25)"],"invBoxTip":["Tip Box (8x12)","枪头盒 (8x12)"],"invBoxTube":["Tube Rack (4x6)","试管架 (4x6)"],"invBoxType":["Box Type","盒子类型"],"invBulkAddBtn":["Add","添加"],"invBulkAddHint":["This will add the same sample to all selected empty positions","将在所有选中的空位置添加相同的样品"],"invBulkAddTitle":["Bulk Add Samples","批量添加样品"],"invBulkDel":["Del","删"],"invBulkDelConfirm":["Confirm?","确认删除?"],"invBulkEdit":["Edit","编辑"],"invBulkEditHint":["Only fill in fields you want to change. Leave blank to keep current.","只填写需要修改的字段，留空则不更改"],"invBulkEditTitle":["Bulk Edit","批量编辑"],"invBulkNoChange":["-- No change --","-- 不更改 --"],"invCancel":["Cancel","取消"],"invCancelSelect":["x Cancel","x 取消"],"invChineseName":["Chinese Name","中文名称"],"invClearFilters":["Clear filters","清除筛选"],"invClickToAdd":["Click an empty cell to add a sample","点击空白格子添加样品"],"invColBox":["Box","盒子"],"invColDate":["Date","日期"],"invColLocation":["Location","位置"],"invColName":["Name","名称"],"invColOwner":["Owner","负责人"],"invColPos":["Pos","位"],"invColQty":["Qty","数量"],"invColType":["Type","类型"],"invColor":["Color Label","颜色标签"],"invCols":["Columns","列数"],"invConcentration":["Concentration","浓度"],"invConfirm":["Confirm","确认"],"invDashboardDismiss":["Dismiss","关闭"],"invDashboardRecent":["Recently Added","最近添加"],"invDashboardShow":["Dashboard","仪表盘"],"invDateStored":["Date Stored","存储日期"],"invDeleteBox":["Delete this box","删除此盒子"],"invDeleteConfirm":["Are you sure? This cannot be undone.","确定删除？此操作不可撤销。"],"invDeleteLocation":["Delete this location","删除此位置"],"invDeleteSample":["Delete this sample","删除此样品"],"invDescription":["Description","描述"],"invDownloadTemplate":["Download CSV Template","下载 CSV 模板"],"invDuplicate":["Duplicate","复制"],"invEditBox":["Edit Box","编辑盒子"],"invEditLocation":["Edit Location","编辑位置"],"invEditSample":["Edit Sample","编辑样品"],"invEmpty":["empty","空位"],"invEmptyCount":[" empty)","空)"],"invExpiryDate":["Expiry Date","过期日期"],"invExport":["Export","导出"],"invExportAllCsv":["Export All (CSV)","导出全部 (CSV)"],"invExportBoxCsv":["Export This Box (CSV)","导出当前盒 (CSV)"],"invExportJson":["Export Backup (JSON)","导出备份 (JSON)"],"invImport":["Import","导入"],"invImportCsv":["Import CSV","导入 CSV"],"invImportJson":["Import Backup (JSON)","导入备份 (JSON)"],"invListView":["Sample List","样品列表"],"invLocationType":["Storage Type","存储类型"],"invName":["Name","名称"],"invNameZh":["Chinese Name","中文名"],"invNoResults":["No matching samples","未找到匹配样品"],"invNoSamples":["No samples yet","暂无样品"],"invNoUndo":["Nothing to undo","没有可撤销的操作"],"invNotes":["Notes","备注"],"invOccupied":["occupied","已用"],"invOwner":["Owner","负责人"],"invPassage":["Passage","代数"],"invPosition":["Position","位置"],"invPositionsCount":[" positions)"," 个位置)"],"invPrint":["Print","打印"],"invQuantity":["Quantity","数量"],"invResults":[" results"," 条"],"invRows":["Rows","行数"],"invSampleAntibody":["Antibody","抗体"],"invSampleCellLine":["Cell Line","细胞系"],"invSampleNameReq":["Sample Name *","样品名称 *"],"invSampleOther":["Other","其他"],"invSamplePlasmid":["Plasmid","质粒"],"invSamplePrimer":["Primer","引物"],"invSampleProtein":["Protein","蛋白"],"invSampleReagent":["Reagent","试剂"],"invSampleTissue":["Tissue","组织"],"invSampleType":["Sample Type","样品类型"],"invSampleVirus":["Virus","病毒"],"invSamples":["Samples","样品"],"invSamplesCount":[" samples)"," 个样品)"],"invSave":["Save","保存"],"invSearch":["Search samples...","搜索样品..."],"invSearchName":["Search name...","搜索名称..."],"invSelCount":[" sel"," 已选"],"invSelect":["Select","选择"],"invSelectABox":["Select a box","选择一个盒子"],"invSelectBox":["Select a box from the tree to view its contents","从左侧树形结构中选择一个盒子查看内容"],"invStats":["Stats","统计"],"invStatsBoxes":["Boxes","盒子"],"invStatsByType":["Samples by Type","按类型分类"],"invStatsDays":["days","天"],"invStatsEmpty":["No inventory data yet","暂无库存数据"],"invStatsExpiring":["Expiring Soon","即将过期"],"invStatsLocations":["Locations","位置"],"invStatsOccupied":["occupied","已用"],"invStatsRecentlyAdded":["Recently Added","最近添加"],"invStatsSamples":["Samples","样品"],"invStatsTitle":["Inventory Statistics","库存统计"],"invStatsTotal":["total","总计"],"invStatsUtilization":["Storage Utilization","存储利用率"],"invStorageTree":["Storage","存储位置"],"invTags":["Tags (comma-separated)","标签（逗号分隔）"],"invTagsShort":["Tags","标签"],"invTemperature":["Temperature","温度"],"invTypeFreezer":["Freezer","冰箱"],"invTypeFridge":["Fridge","冷藏"],"invTypeRack":["Rack","冻存架"],"invTypeShelf":["Shelf","架子"],"invTypeTank":["Liquid N2 Tank","液氮罐"],"invUndo":["Undo","撤销"],"invUndoLast":["Undo last action","撤销上一步操作"],"invUndone":["Undone","已撤销"],"itemsCount":["{n} items","{n} 项"],"keepScreenOn":["Keep screen on","屏幕常亮"],"keepScreenOnHint":["Stops the screen dimming or locking while this page is open","打开此页面时，屏幕不会变暗或自动锁定"],"labelName":["Label / Condition","标签/条件名"],"langToggle":["中文","EN"],"languageLabel":["Language","语言"],"legend":["Legend","图例"],"lightMode":["Light","浅色"],"localDataOnly":["Local data only","仅本地存储"],"markWells":["Mark Selected Wells","标记选中孔"],"massCalc":["Mass Calculator","质量计算"],"massCalcDesc":["Calculate the reagent mass needed to prepare a solution at a target concentration and volume.","根据目标浓度与体积计算所需试剂质量。"],"massCalcTitle":["Mass Calculator","质量计算器"],"massConcDesc":["Desired molar concentration","目标摩尔浓度"],"massFormula":["m = MW × C × V"],"massMwDesc":["Molecular Weight of reagent","试剂分子量"],"massNeeded":["Mass needed","需要称量"],"massNeededLabel":["Mass needed","需要称量"],"massPrepDissolve":["of reagent and dissolve in","试剂，溶于"],"massPrepSolution":["solution","溶液"],"massPrepSummary":["How to prepare","配制方法"],"massPrepTo":["to make","配制"],"massPrepWeigh":["Weigh","称取"],"massVolDesc":["Volume of solution to prepare","需配制的溶液体积"],"materialsLabel":["Materials","所需材料"],"measuredMass":["Measured Mass","已称质量"],"media":["Media","培养基"],"molConc":["Molar concentration","摩尔浓度"],"molMassDesc":["Mass of solute weighed","已称溶质质量"],"molMwDesc":["Molecular Weight of solute","溶质分子量"],"molVolDesc":["Total solution volume","溶液总体积"],"molarityCalc":["Molarity","摩尔浓度"],"molarityCalcDesc":["Convert between mass and molar concentration for a given molecular weight and volume.","已知分子量与体积，在质量与摩尔浓度之间互相换算。"],"molarityCalcTitle":["Molarity Calculator","摩尔浓度计算"],"molarityFormula":["C = m / (MW × V)"],"mwAtomicMass":["Atomic Mass","原子量"],"mwBreakdown":["Element Breakdown","元素组成"],"mwCalcDesc":["Compute molecular weight from any chemical formula (e.g. C₆H₁₂O₆, NaHCO₃, Fe₂(SO₄)₃) using IUPAC atomic masses.","输入任意化学式（如 C₆H₁₂O₆、NaHCO₃、Fe₂(SO₄)₃）自动计算分子量，基于 IUPAC 标准原子量。"],"mwCalcSubtitle":["Enter a chemical formula to calculate molecular weight","输入化学式计算分子量"],"mwCalcTitle":["Molecular Weight Calculator","分子量计算器"],"mwCommon":["Common Molecules","常用分子"],"mwCount":["Count","个数"],"mwElement":["Element","元素"],"mwFormula":["Chemical Formula","化学式"],"mwFormulaPlaceholder":["e.g. NaCl, H₂SO₄, Ca(OH)₂","如 NaCl、H₂SO₄、Ca(OH)₂"],"mwLabel":["MW (g/mol)","分子量 MW (g/mol)"],"mwParseError":["Invalid formula","化学式无效"],"mwRange":["Gel % vs MW Separation Range","胶浓度与分离范围参考"],"mwResult":["Molecular Weight","分子量"],"mwSubtotal":["Subtotal","小计"],"navHelp":["Help","帮助"],"navLibrary":["Library","资料库"],"navMain":["Main navigation","主导航"],"navMore":["More","更多"],"navMyLab":["My lab","我的实验室"],"navSearch":["Search…","搜索…"],"navSearchShort":["Search","搜索"],"navSettings":["Settings","设置"],"navTools":["Tools","工具"],"nbActualParams":["Actual Parameters","实际参数"],"nbAddCheckItem":["Add Item","添加项目"],"nbAddEquipment":["Add Equipment","添加设备"],"nbAddFigure":["Add Figure","添加图表"],"nbAddReagent":["Add Reagent","添加试剂"],"nbAll":["All","全部"],"nbAmount":["Amount","用量"],"nbAutoSaved":["Auto-saved","已自动保存"],"nbBackupStatus":["Backup Status","备份状态"],"nbCancel":["Cancel","取消"],"nbChecklist":["Checklist","检查清单"],"nbDataProcessing":["Data Processing","数据处理"],"nbDate":["Date","日期"],"nbDeleteConfirm":["Delete this experiment entry? This cannot be undone.","删除此实验记录？此操作不可撤销。"],"nbDeleteEntry":["Delete Entry","删除记录"],"nbDeviation":["Deviation","偏差记录"],"nbDuration":["Duration (min)","时长（分钟）"],"nbEndTime":["End Time","结束时间"],"nbEntryTitle":["Title","标题"],"nbEntryTitleZh":["Title (Chinese)","中文标题"],"nbEquipment":["Equipment","设备"],"nbEquipmentName":["Equipment","设备名"],"nbExportJson":["Export JSON","导出 JSON"],"nbExportMd":["Export Markdown","导出 Markdown"],"nbFigureDesc":["Description","描述"],"nbFigureNotes":["Notes","备注"],"nbFigures":["Figures","图片/图表"],"nbFreetextMode":["Free Text","自由记录"],"nbImportJson":["Import JSON","导入 JSON"],"nbImportPlateLayout":["Import Plate Layout","导入板布局"],"nbImportProtocol":["Import from Protocol","从方案导入"],"nbLinkedProtocol":["Linked Protocol","关联方案"],"nbLocation":["Location","位置"],"nbMaterials":["Materials","实验材料"],"nbNewEntry":["New Entry","新建记录"],"nbNoEntries":["No experiment entries yet","暂无实验记录"],"nbNoEntriesHint":["Click \"New Entry\" to create your first experiment record","点击\"新建记录\"创建第一条实验记录"],"nbNotes":["Notes","备注"],"nbObjectives":["Objectives","实验目的"],"nbPending":["Pending","待准备"],"nbPlan":["Plan","实验计划"],"nbPriority":["Priority","优先级"],"nbPriorityHigh":["High","高"],"nbPriorityLow":["Low","低"],"nbPriorityMedium":["Medium","中"],"nbProcedure":["Procedure","实验步骤"],"nbReady":["Ready","就绪"],"nbReagentName":["Reagent Name","试剂名"],"nbReagents":["Reagents","试剂"],"nbResults":["Results","实验结果"],"nbSave":["Save","保存"],"nbSearch":["Search entries...","搜索记录..."],"nbSearchInventory":["Search Inventory","搜索库存"],"nbSelectEntry":["Select an entry to view details","选择左侧记录查看详情"],"nbStartTime":["Start Time","开始时间"],"nbStatus":["Status","状态"],"nbStatusCancelled":["Cancelled","已取消"],"nbStatusCompleted":["Completed","已完成"],"nbStatusInProgress":["In Progress","进行中"],"nbStatusPlanned":["Planned","计划中"],"nbSubtitle":["Structured experiment records with protocol integration","结构化实验记录，支持方案集成"],"nbSummary":["Summary","总结"],"nbTemplateMode":["From Protocol","来自方案"],"nbTitle":["Experiment Notebook","实验记录本"],"nbUnit":["Unit","单位"],"noResults":["No matching results","未找到匹配结果"],"notes":["Notes","备注"],"numGels":["Number of Gels","胶数量"],"numSamples":["Number of samples / reactions","样品/反应数"],"onboardingCalcBody":["Dilution, mass, molarity, percentage, dead volume, and SDS-PAGE gel calculators — all in one place.","稀释、质量、摩尔浓度、百分比、配液量和 SDS-PAGE 配胶计算器——一站式使用。"],"onboardingCalcTitle":["Use Calculators","使用计算器"],"onboardingDone":["Get Started","开始使用"],"onboardingNavBody":["On a computer every section lives in the sidebar, grouped as Library, Tools and My lab. On a phone the four you use most sit in the bottom bar and the rest are under More.","电脑上，所有功能都在侧边栏中，按「资料库」「工具」「我的实验室」分组；手机上，最常用的四项在底部导航栏，其余在「更多」里。"],"onboardingNavTitle":["Find your way around","快速找到功能"],"onboardingNext":["Next","下一步"],"onboardingPlateBody":["Multi-well plate designer with templates. Sample inventory with visual grid tracking.","多孔板设计器含快速模板。样品库存可视化网格追踪。"],"onboardingPlateTitle":["Design Plates & Track Samples","设计板布局与追踪样品"],"onboardingPrev":["Back","上一步"],"onboardingPrivacyBody":["No servers, no tracking, no cookies. Back up your data anytime from the sidebar or the Guide page.","无服务器、无追踪、无 Cookie。随时可在侧边栏或「使用说明」页备份数据。"],"onboardingPrivacyTitle":["Your Data Stays Local","数据完全本地存储"],"onboardingRecipesBody":["Verified buffer recipes and step-by-step protocols with built-in timers. Star your favorites for quick access.","已验证的缓冲液配方和分步实验方案，内置计时器。收藏常用配方快速访问。"],"onboardingRecipesTitle":["Browse Recipes & Protocols","浏览配方与实验方案"],"onboardingSkip":["Skip","跳过"],"onboardingToolsBody":["A timer and a quick calculator are always one click away — in the sidebar on a computer, in the top bar on a phone — plus curated links to essential bioinformatics resources.","计时器和快速计算器随时可用——电脑上在侧边栏，手机上在顶部栏——另有精选生物信息学资源链接。"],"onboardingToolsTitle":["Quick Tools & Timer","快捷工具与计时器"],"onboardingWelcomeBody":["Your all-in-one molecular biology toolkit. Everything runs locally in your browser — no account needed.","您的一站式分子生物学工具箱。完全在浏览器中运行——无需账号。"],"onboardingWelcomeTitle":["Welcome to bioinfospace labmate","欢迎使用 bioinfospace labmate"],"pageCalcDesc":["Dilution, mass, molarity, unit conversion and more — computed on your device.","稀释、质量、摩尔浓度、单位换算等，全部在本地计算。"],"pageInventoryDesc":["Freezers, racks and boxes with position-level sample tracking.","冰箱、架子与冻存盒，按孔位管理样品。"],"pageProtocolsDesc":["Step-by-step bench protocols with built-in timers and progress tracking.","分步实验方案，内置计时器与进度记录。"],"pageRecipesDesc":["Buffers, media and staining solutions — scale any recipe to your working volume.","缓冲液、培养基与染色液——按目标体积一键换算。"],"pctLabel":["Percentage (%)","百分比(%)"],"pctPercDesc":["Target percentage","目标百分比"],"pctSoluteDescVV":["Volume of liquid solute (v/v)","需加入液体溶质体积 (v/v)"],"pctSoluteDescWV":["Mass of solute to add (w/v)","需加入溶质质量 (w/v)"],"pctVolDesc":["Total solution volume","溶液总体积"],"percentCalc":["% Solution","百分比溶液"],"percentCalcDesc":["Calculate % (w/v) or (v/v) solutions — either the percent from inputs, or the solute needed for a target percent.","配制 % (w/v) 或 (v/v) 溶液：由输入值反推百分比，或计算目标百分比所需的溶质量。"],"percentCalcTitle":["Percentage Solution","百分比溶液配制"],"percentConc":["Percentage Concentration (%)","百分比浓度 (%)"],"periodicAtomicMass":["Atomic Mass","原子量"],"periodicAtomicNum":["Atomic Number","原子序数"],"periodicCategory":["Category","类别"],"periodicDesc":["Browse all 118 elements — click any cell for atomic number, mass, electron configuration, and group/period context.","浏览全部 118 种元素，点击任一元素查看原子序数、相对原子质量、电子排布及所在族与周期。"],"periodicDetails":["Element Details","元素详情"],"periodicElectronConfig":["Electron Configuration","电子构型"],"periodicSearch":["Search elements...","搜索元素..."],"periodicSubtitle":["Click any element for details","点击元素查看详情"],"periodicTitle":["Interactive Periodic Table","交互式元素周期表"],"phLabel":["pH"],"plateAntibodyTitration":["Antibody Titration","抗体滴定"],"plateBlank":["Blank","空白"],"plateCheckerboard":["Checkerboard","棋盘格"],"plateClear":["Clear All","清空全部"],"plateClose":["Close","关闭"],"plateConfirm":["Confirm","确认标记"],"plateControlLayout":["Control Layout","对照布局"],"plateCustomColor":["Custom Color","自定义颜色"],"plateDose":["Dose-Response","多药物梯度"],"plateEnlarge":["Enlarge","放大"],"plateExport":["Export Layout","导出板布局"],"plateLabelName":["Label / Condition","标签/条件名"],"plateLegend":["Legend","图例"],"plateMarkTitle":["Mark Selected Wells","标记选中孔"],"plateModeDesigner":["Designer","布板设计"],"plateModeReader":["Reader Import","读板数据导入"],"plateNegCtrl":["Negative Control","阴性对照"],"plateNumAntibodies":["Number of antibodies","抗体数量"],"platePosCtrl":["Positive Control","阳性对照"],"plateReplicates":["Replicates","重复数"],"plateSelected":["selected","已选"],"plateSerial":["Serial Dilution","梯度稀释"],"plateSubtitle":["Design plate layouts with templates and free editing","设计实验板布局，支持模板和自由编辑"],"plateTemplates":["Quick Templates","快速模板"],"plateTitle":["Multi-well Plate Designer","多孔板设计器"],"plateType":["Plate Type","板型"],"plateViewGrid":["Plate View","板视图"],"plateViewTable":["Table View","表格视图"],"prepSteps":["Preparation Steps","配制步骤"],"prepStepsLabel":["Preparation","配制步骤"],"presets":["Common Presets","常用预设"],"privacyBody":["bioinfospace labmate runs entirely in your browser. Your favorites, step progress, notebook entries, inventory, and settings are stored locally on your device using IndexedDB (with localStorage as fallback). None of this data leaves your device — the one exception is the optional AI Assistant (off by default): when you use it, the messages you send are relayed through our server to a language-model provider to generate replies. No account required. No tracking. No cookies beyond essential browser storage. You own your data — export everything, including notebook entries, anytime from the sidebar or Guide → Backup & restore.","bioinfospace labmate 完全在您的浏览器中运行。您的收藏、实验进度、实验记录、库存和设置等所有个人数据都使用 IndexedDB（localStorage 作为备用）存储在本地设备上。这些数据都不会离开你的设备——唯一的例外是可选的 AI 助手（默认关闭）：使用它时，你发送的消息会经我们的服务器转发给语言模型服务商以生成回复。无需账号。无追踪。无 Cookie（仅必要的浏览器存储）。数据完全归您所有——可随时在侧边栏或「使用说明 → 备份与恢复」中一键导出全部数据（含实验记录）。"],"privacyTitle":["Your Data Stays Private","您的数据完全私密"],"protocol":["Protocol"],"quickCalc":["Calculator","计算器"],"readerCV":["CV%","变异系数%"],"readerClear":["Clear","清空"],"readerDetected":["Detected","识别到"],"readerDownloadCSV":["Download CSV","下载 CSV"],"readerErr":["Could not parse","解析失败"],"readerErrUnknown":["Unknown error.","未知错误。"],"readerErr_empty":["Input is empty.","输入为空。"],"readerErr_no_data":["No data rows found.","未找到数据行。"],"readerErr_no_numeric_block":["No numeric block detected.","未识别到数值区域。"],"readerErr_unknown_plate_size":["Grid dimensions don't match a known plate format (6, 12, 24, 48, 96, 384).","数据维度与常见孔板尺寸（6/12/24/48/96/384）不匹配。"],"readerInputDesc":["Auto-detects 6/12/24/48/96/384-well plates and pivots to long format.","自动识别 6/12/24/48/96/384 孔板，转换为长格式（tidy）数据。"],"readerInputTitle":["Paste or upload plate reader data","粘贴或上传读板仪数据"],"readerLayoutMismatch":["Designer plate is {designer}-well, but parsed data is {parsed}-well. Labels cannot be merged.","设计器为 {designer} 孔板，导入数据为 {parsed} 孔板，标签无法合并。"],"readerLoadDemo":["Load demo","加载示例"],"readerLoadFile":["Load file","选择文件"],"readerLongFormat":["Long-format (tidy) data","长格式（tidy）数据"],"readerMean":["mean","均值"],"readerMergeLabels":["Merge sample labels from designer","合并设计器中的样品标签"],"readerMoreRows":["more rows in download","更多行已包含在下载中"],"readerParsedValues":["values parsed","个数值已解析"],"readerPaste":["Paste tab-, comma-, or semicolon-separated values here. Row/column headers are optional.","在此粘贴 Tab、逗号或分号分隔的数值。行/列标题可选。"],"readerRows":["rows","行"],"readerSD":["sd","标准差"],"readerSample":["Sample","样品"],"readerSkipped":["skipped","已跳过"],"readerSummary":["Summary by sample group","按样品分组的统计"],"readerSupportedFormats":["Tecan, BioTek, SpectraMax, Molecular Devices — works with any grid CSV/TSV.","兼容 Tecan、BioTek、SpectraMax、Molecular Devices 等设备的 CSV/TSV 数据。"],"readerValue":["value","数值"],"readerWell":["well","孔位"],"reagent":["Reagent","试剂"],"recentlyUsed":["Recent","最近"],"recipesUpdated":["Recipes updated","配方已更新"],"referenceLabel":["Reference","参考文献"],"refreshRecipes":["Refresh Recipes","刷新配方"],"refsSubtitle":["How to use each feature in labmate","labmate 各功能使用说明"],"refsTitle":["Guide","使用说明"],"removedFav":["Removed from favorites","已取消收藏"],"replayTour":["Replay Tour","重新播放引导"],"resolvingConc":["Resolving Gel %","分离胶浓度 (%)"],"resolvingVol":["Resolving Vol (mL)","单胶分离体积 (mL)"],"result":["Result","结果"],"resultsCount":["{n} shown","显示 {n} 项"],"safeStop":["Safe stopping point","安全暂停点"],"safetyNotes":["Safety & Tips","操作注意事项"],"scaleFactor":["Scale","倍数"],"scaleRecipe":["→ Scale a recipe to this volume","→ 按此量缩放配方"],"scientificCalcDesc":["Expression calculator with trig, logarithms, powers, roots, factorial and constants (π, e). Toggle DEG/RAD for angles.","支持三角函数、对数、幂、开方、阶乘及常数（π、e）的表达式计算器。可切换角度制/弧度制（DEG/RAD）。"],"searchBy":["Search by reagent, tag, name, or notes","按试剂名、标签、中文名、备注检索"],"searchContains":["Contains","含有"],"searchHint":["Type to search all recipes & protocols","输入关键词搜索所有配方和 protocol"],"searchPlaceholder":["Search recipes, reagents, tags...","搜索配方、试剂名、标签..."],"selectRecipe":["Select a recipe to view details","选择左侧配方查看详情"],"selected":["selected","已选"],"serialDilution":["Serial Dilution","梯度稀释"],"serialFactor":["Dilution factor (e.g. 2 = half each step)","稀释倍数 (如 2 = 每步减半)"],"serialStartConc":["Starting concentration (e.g. 100 µM)","起始浓度 (如 100 µM)"],"showList":["Show list","显示列表"],"solnVolume":["Solution Volume","溶液体积"],"soluteG":["Solute (g)","溶质(g)"],"soluteML":["Solute (mL)","溶质(mL)"],"soluteMass":["Solute Mass (g)","溶质质量 (g)"],"soluteVol":["Solute Volume (mL)","溶质体积 (mL)"],"solveFor":["Solve for","求解"],"stackingConc":["Stacking Gel %","浓缩胶浓度 (%)"],"stackingVol":["Stacking Vol (mL)","单胶浓缩体积 (mL)"],"staining":["Staining","染色液"],"stepComplete":["complete","已完成"],"stepOf":["of","/"],"stepProgress":["Progress","进度"],"stepReset":["Reset","重置"],"stepsLabel":["Steps","实验步骤"],"storageBestEffort":["Storage: best-effort — browsers may clear local data after long inactivity. Export a backup regularly.","存储：尽力保留——长期不使用时浏览器可能清除本地数据，请定期导出备份。"],"storageLabel":["Storage","储存"],"storagePersistent":["Storage: persistent — your browser will not auto-evict this data.","存储：持久化——浏览器不会自动清除这些数据。"],"systemBadge":["System","系统"],"tabBuffers":["Recipes","配方库"],"tabCalc":["Calculator","计算器"],"tabCalcShort":["Calc","计算"],"tabCalendar":["Calendar","实验日历"],"tabInventory":["Inventory","样品库存"],"tabNotebook":["Notebook","实验记录"],"tabPlate":["Plate Designer","多孔板设计"],"tabPlateShort":["Plate","孔板"],"tabProtocols":["Protocols","实验方案"],"tabRefs":["Guide","使用说明"],"tabTools":["Links","常用链接"],"targetConc":["Target Concentration","目标浓度"],"targetVol":["Target Volume","目标体积"],"targetVolume":["Target Volume","目标体积"],"templates":["Quick Templates","快速模板"],"themeDark":["Dark","深色"],"themeLabel":["Theme","主题"],"themeLight":["Light","浅色"],"themeToggle":["Switch light/dark theme","切换浅色/深色主题"],"timerAdd":["Quick Timer","快速计时"],"timerDone":["Time's up!","时间到！"],"timerFinishedAt":["Finished","结束于"],"timerMinutes":["min","分钟"],"timerNotifyTitle":["Timer done","计时结束"],"timerPause":["Pause","暂停"],"timerReset":["Reset","重置"],"timerResume":["Resume","继续"],"timerRunning":["Running timers","进行中的计时"],"timerStart":["Start","开始"],"tip":["Tip","提示"],"toolAssistant":["Assistant","助手"],"toolCalc":["Calc","计算"],"toolCatBIS":["Bioinfospace Apps","Bioinfospace 应用"],"toolCatCancer":["Cancer Genomics","肿瘤基因组学"],"toolCatClinical":["Clinical & Pharmacology","临床 & 药理"],"toolCatData":["Data & Image","数据 & 图像"],"toolCatGenome":["Genome & Pathway","基因组 & 通路"],"toolCatPathway":["Pathway & Network","通路 & 网络"],"toolCatPrimer":["Primer & Sequence","引物 & 序列"],"toolCatProtein":["Protein & Antibody","蛋白 & 抗体"],"toolCatSingleCell":["Single Cell","单细胞"],"toolCatStructure":["Structure & Modeling","结构 & 建模"],"toolTimer":["Timer","计时"],"toolsSubtitle":["Curated links to best-in-class free resources — no need to reinvent the wheel","精选免费最佳工具——不重复造轮子"],"toolsTitle":["Useful Links","实用链接"],"totalNeeded":["Total volume needed","需要配制总量"],"totalRecipes":["recipes/protocols available","个配方/protocol 可供检索"],"unit":["Unit","单位"],"usageGuide":["Usage Notes","使用说明"],"usedIn":["Used in:","相关实验:"],"usedInLabel":["Used in","相关实验"],"volML":["Volume (mL)","体积(mL)"],"volPerSample":["Volume per sample","每份用量"],"vv":["% (v/v) Volume/Volume","% (v/v) 体积/体积"],"wells":["wells","孔"],"withoutDead":["Without dead volume","不含余量"],"wv":["% (w/v) Mass/Volume","% (w/v) 质量/体积"]};

function t(key, lang) {
  var e = D[key];
  if (!e) return key;
  return (lang === 'zh' && e[1]) || e[0] || key;
}

// One {n} placeholder, e.g. i.n('resultsCount', lang, 12)
function n(key, lang, value) {
  return t(key, lang).split('{n}').join('' + value);
}

module.exports = { t: t, n: n };
