.lv-filters { padding: 12px; border-bottom: 1px solid var(--rule); }
.lv-clear { color: var(--text-muted); font-size: 15px; padding: 4px; }
.lv-picker { min-height: 34px; height: 34px; font-size: 13px; }
.lv-recent-label { font-size: 10px; }
.lv-recent { min-height: 26px; font-size: 11px; max-width: 176px; }
.lv-row { padding: 0; align-items: stretch; }
.lv-main { padding: 10px 4px 10px 14px; }
.lv-cat { font-weight: 700; }
.lv-star {
  width: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: var(--text-muted);
  opacity: 0.5;
}
.lv-star.fav-on { opacity: 1; color: var(--fav-star); }
.lv-foot {
  padding: 8px 14px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  border-top: 1px solid var(--rule);
}
