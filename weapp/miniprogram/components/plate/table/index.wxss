.ptv-count { padding: 8px 14px; font-size: 11px; color: var(--text-muted); border-bottom: 1px solid var(--rule); }
.ptv-empty { padding: 20px 14px; font-size: 13px; color: var(--text-muted); text-align: center; }
.ptv .th { font-size: 10px; white-space: nowrap; }
.ptv .ptv-sorted { color: var(--text); }
.ptv-press { background: var(--bg-2); }
.ptv .ptv-well { width: 58px; flex-shrink: 0; padding-left: 14px; font-size: 13px; font-weight: 700; }
.ptv .th.ptv-well { padding-left: 14px; }
.ptv .ptv-row, .ptv .ptv-col { width: 34px; flex-shrink: 0; font-size: 13px; }
.ptv .ptv-label { flex: 1; font-size: 14px; font-weight: 500; }
.ptv .ptv-color { width: 92px; flex-shrink: 0; display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-muted); }
.ptv-dot { width: 10px; height: 10px; flex-shrink: 0; border: 0; }
