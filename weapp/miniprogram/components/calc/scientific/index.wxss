@import "../calc.wxss";

/* Instrument: display + keypad inside one ink frame */
.sc-box { border: 1px solid var(--border-strong); }
.sc-display {
  padding: 8px 14px 10px 18px;
  background: var(--primary-light);
  border-bottom: 1px solid var(--border-strong);
  box-shadow: inset 4px 0 0 var(--primary);
}
.sc-display.is-error { background: var(--danger-bg); box-shadow: inset 4px 0 0 var(--danger-border); }
.sc-flags {
  display: flex;
  justify-content: space-between;
  min-height: 16px;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--text-muted);
}
.sc-expr {
  min-height: 34px;
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 700;
  line-height: 1.2;
  text-align: right;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}
/* Long expressions shrink and wrap instead of hiding what was just typed */
.sc-expr.is-long { font-size: 19px; line-height: 1.35; }
.sc-preview {
  min-height: 21px;
  font-family: var(--font-mono);
  font-size: 15px;
  line-height: 1.4;
  text-align: right;
  color: var(--text-muted);
  word-break: break-all;
}
.sc-display.is-error .sc-preview { color: var(--danger-text); }

/* Keypad: hairline-separated 5-column grid */
.sc-keys { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--rule); }
.sc-key {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  font-family: var(--font-mono);
  font-weight: 600;
}
.sc-span2 { grid-column: span 2; }
.sc-num { background: var(--card); color: var(--text); font-size: 19px; }
.sc-fn { background: var(--bg-2); color: var(--text-muted); font-size: 15px; }
.sc-op { background: var(--bg-2); color: var(--accent); font-size: 20px; }
.sc-eq { background: var(--primary); color: var(--on-primary); font-size: 20px; }
.sc-ctl { background: var(--bg-3); color: var(--text); font-size: 14px; }
.sc-key.is-pressed { filter: brightness(0.9); }
.sc-k-back { font-size: 21px; }
