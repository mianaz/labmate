@import "../components/nb-shared/nb.wxss";

/* Period navigation */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 6px;
  border-bottom: 1px solid var(--rule);
}
.cal-period { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
.cal-period-main {
  font-family: var(--font-heading);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  white-space: nowrap;
}
.cal-period-year { font-size: 13px; font-weight: 500; color: var(--text-muted); }

/* Month grid: hairline rules between cells */
.cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1px; background: var(--rule); }
.cal-dow { border-bottom: 1px solid var(--border-strong); }
.cal-dow-cell { padding: 5px 0; font-size: 10px; text-align: center; background: var(--card); }
.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  min-width: 0;
  min-height: 50px;
  padding: 6px 0 5px;
  background: var(--card);
}
.cal-cell.is-out { background: var(--bg); }
.cal-cell.is-pressed { background: var(--bg-2); }
.cal-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 26px;
  height: 26px;
  padding: 0 4px;
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--text);
  border: 1px solid transparent;
}
.cal-cell.is-out .cal-num { color: var(--text-muted); font-weight: 400; }
.cal-num.is-today { background: var(--primary); color: var(--on-primary); border-color: var(--border-strong); font-weight: 700; }
.cal-num.is-selected { background: var(--text); color: var(--bg); border-color: var(--text); font-weight: 700; }
.cal-cell.is-out .cal-num.is-selected { color: var(--bg); font-weight: 700; }
.cal-dots { display: flex; align-items: center; gap: 2px; height: 5px; }
.cal-dot { width: 5px; height: 5px; }

.cal-legend { margin-top: 10px; }

/* Week: seven day rows */
.cal-wday + .cal-wday { border-top: 1px solid var(--rule); }
.cal-wday-head { display: flex; align-items: center; gap: 8px; min-height: 42px; padding: 3px 4px 3px 14px; }
.cal-wday.is-today .cal-wday-head { background: var(--primary-light); }
.cal-wday-dow { min-width: 28px; }
.cal-wday-count { font-size: 11px; color: var(--text-muted); }
.cal-wday-list { border-top: 1px solid var(--rule); }

/* Agenda */
.cal-count { font-size: 11px; color: var(--text-muted); }
.cal-group { padding: 5px 14px; background: var(--bg-2); border-bottom: 1px solid var(--rule); }
.cal-group + .list + .cal-group { border-top: 1px solid var(--rule); }
.cal-group.is-today { color: var(--text); }
.cal-row { gap: 10px; padding-left: 16px; }
.cal-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--st-fg);
}
.cal-row.is-hl { background: var(--bg-2); }
.cal-time { width: 44px; flex-shrink: 0; font-size: 13px; font-weight: 700; }
.cal-cancelled { color: var(--text-muted); text-decoration: line-through; }
.cal-empty { padding: 28px 20px; }

.cal-ics-count { font-size: 12px; color: var(--text-muted); }
.cal-ics-count.is-warn { color: var(--warning-text); }
