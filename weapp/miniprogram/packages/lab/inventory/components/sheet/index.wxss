.inv-sheet { display: flex; flex-direction: column; max-height: 88vh; }
.inv-sheet.is-tall { height: 88vh; }
.inv-sheet-head { flex-shrink: 0; padding: 8px 8px 8px 16px; }
.inv-sheet-title { font-family: var(--font-heading); font-size: 17px; font-weight: 700; line-height: 1.3; min-width: 0; }
.inv-sheet-meta { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); min-width: 0; flex-shrink: 1; }
.inv-sheet-scroll { flex: 1; min-height: 0; max-height: calc(88vh - 120px); }
.inv-sheet.is-tall .inv-sheet-scroll { max-height: none; }
.inv-sheet-foot {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding: 10px 16px;
  border-top: 1px solid var(--rule);
  background: var(--card);
}
