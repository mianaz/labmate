.inv-color { position: relative; width: 28px; height: 28px; flex-shrink: 0; border: 1px solid var(--border-strong); }
.inv-color.is-active { box-shadow: 0 0 0 2px var(--card), 0 0 0 3px var(--text); }
.inv-color.is-none { background: var(--card); overflow: hidden; }
.inv-color-x { position: absolute; left: -4px; right: -4px; top: 50%; height: 1px; background: var(--danger-border); transform: rotate(-45deg); }
.inv-color-preview { width: 20px; height: 20px; }
.inv-hex { width: 150px; flex-shrink: 0; }
