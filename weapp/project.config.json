{
  "description": "LabMate — WeChat Mini Program. Open this folder (weapp/) in WeChat DevTools.",
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "labmate",
  "libVersion": "3.5.0",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXML": true,
    "minifyWXSS": true,
    "urlCheck": true,
    "compileHotReLoad": true,
    "babelSetting": {
      "ignore": ["data/recipes.js"],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [],
    "include": []
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "condition": {}
}
